include {
  path = find_in_parent_folders()
  expose = true
}

terraform {
  source = "../../../stacks/dynamodb"
}

inputs = {
  name        = "dlx-pci-dev-batch-audit"
  environment = "dev"

  region = "<dev-primary-region>"

  # Table key configuration - confirm with developer
  hash_key  = "<partition-key>"
  range_key = "<sort-key>"

  attributes = [
    {
      name = "<partition-key>"
      type = "S"
    },
    {
      name = "<sort-key>"
      type = "S"
    }
  ]

  billing_mode = "PAY_PER_REQUEST"

  point_in_time_recovery_enabled = true

  read_capacity  = 0
  write_capacity = 0

  table_class = "STANDARD"

  # Retention settings - confirm with developer
  ttl_enabled        = false
  ttl_attribute_name = "<ttl-attribute>"

  stream_enabled   = false
  stream_view_type = "NEW_AND_OLD_IMAGES"

  server_side_encryption_enabled     = true
  server_side_encryption_kms_key_arn = null

  # Multi-region settings
  enable_multi_region = false

  replica_regions = [
    # "<dev-replica-region>"
  ]

  tags = include.locals.common_tags
}
