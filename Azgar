#!/usr/bin/env bash
set -euo pipefail

export DEBIAN_FRONTEND=noninteractive

# Package version
export package_version="PCI-project-flow.0.2.9"

MODULE_DIR="glue/batch-ingestion"
PACKAGE_DIR="$(mktemp -d)"
export packaged_file="batch-ingestion-${package_version}.zip"

trap 'rm -rf "$PACKAGE_DIR" verify_zip' EXIT

echo "============================================================"
echo "Starting Batch Ingestion Glue Packaging"
echo "Package Version: ${package_version}"
echo "============================================================"

# ============================================================
# Install Build Utilities
# ============================================================

echo "Installing ZIP utilities and build dependencies..."

apt-get update -qq

apt-get install -y -qq \
  zip \
  unzip \
  python3-pip \
  build-essential

apt-get clean
rm -rf /var/lib/apt/lists/*

# ============================================================
# Validate Source
# ============================================================

echo "Validating source files..."

test -f "$MODULE_DIR/src/spark_job.py"
test -d "$MODULE_DIR/src/ingestion"
test -d "$MODULE_DIR/src/ingestion/dataguard"

python --version
python -m pip --version

# ============================================================
# Copy Glue Script
# ============================================================

echo "Copying Glue script..."

cp "$MODULE_DIR/src/spark_job.py" "$PACKAGE_DIR/"

# ============================================================
# Prepare Library Directory
# ============================================================

echo "Preparing library package..."

mkdir -p "$PACKAGE_DIR/library"

# ============================================================
# Upgrade pip
# ============================================================

echo "Upgrading pip..."

python -m pip install --upgrade pip

# ============================================================
# Install Glue Runtime Dependencies
# ============================================================

echo "Installing Glue runtime dependencies..."

python -m pip install \
  --no-cache-dir \
  --target "$PACKAGE_DIR/library" \
  "jsonschema&lt;4.18" \
  "referencing==0.36.2" \
  pg8000

# ============================================================
# Verify Python Dependencies
# ============================================================

echo "Verifying installed Python dependencies..."

PYTHONPATH="$PACKAGE_DIR/library" python -c '
from importlib.metadata import version

import jsonschema
import referencing
import pg8000
from referencing import Registry, Resource

print("jsonschema:", version("jsonschema"))
print("referencing:", version("referencing"))
print("pg8000:", version("pg8000"))

print("Registry import: SUCCESS")
print("Resource import: SUCCESS")
print("All runtime dependencies imported successfully.")
'

# ============================================================
# Copy Ingestion Source
# ============================================================

echo "Copying ingestion package..."

cp -R "$MODULE_DIR/src/ingestion" "$PACKAGE_DIR/library/"

# ============================================================
# Create ingestion.zip
# ============================================================

echo "Creating ingestion.zip..."

(
  cd "$PACKAGE_DIR/library"

  zip -1 -q -r "$PACKAGE_DIR/ingestion.zip" . \
    -x "*/__pycache__/*" \
       "*.pyc" \
       "*.pyo"
)

# ============================================================
# Verify ingestion.zip Contents
# ============================================================

echo "Verifying packaged dependencies..."

unzip -l "$PACKAGE_DIR/ingestion.zip" | grep -E \
  'jsonschema/|referencing/|rpds/|attrs/|pg8000/'

echo "Verifying ingestion source..."

unzip -l "$PACKAGE_DIR/ingestion.zip" | grep \
  'ingestion/dataguard/'

# ============================================================
# Verify ZIP Import
# ============================================================

echo "Verifying imports from final ingestion.zip..."

PYTHONPATH="$PACKAGE_DIR/ingestion.zip" python -c '
import jsonschema
import referencing
import pg8000

from referencing import Registry, Resource

from ingestion.dataguard import (
    InvalidContract,
    ManifestRef,
    SourceConflict,
)

print("jsonschema import: SUCCESS")
print("referencing import: SUCCESS")
print("pg8000 import: SUCCESS")
print("ingestion.dataguard import: SUCCESS")
'

# ============================================================
# Create Deployment Package
# ============================================================

echo "Creating deployment package..."

mkdir -p "$PACKAGE_DIR/deploy"

cp "$PACKAGE_DIR/spark_job.py" "$PACKAGE_DIR/deploy/"
cp "$PACKAGE_DIR/ingestion.zip" "$PACKAGE_DIR/deploy/"

(
  cd "$PACKAGE_DIR/deploy"

  zip -1 -q -r "$OLDPWD/$packaged_file" .
)

# ============================================================
# Validate Deployment Package
# ============================================================

echo "Validating deployment package..."

unzip -t "$packaged_file" >/dev/null

test -s "$packaged_file"

# ============================================================
# Final Package Listing
# ============================================================

echo ""
echo "============================================================"
echo "DEPLOYMENT PACKAGE"
echo "============================================================"

unzip -l "$packaged_file"

echo ""
echo "============================================================"
echo "LIBRARY PACKAGE"
echo "============================================================"

mkdir -p verify_zip

unzip -q "$packaged_file" -d verify_zip

unzip -l verify_zip/ingestion.zip

# ============================================================
# Package Size
# ============================================================

echo ""
echo "============================================================"
echo "PACKAGE SIZE"
echo "============================================================"

ls -lh "$packaged_file"

# ============================================================
# Harness Output Variables
# ============================================================

echo "packaged_file $packaged_file" >> /addon/tmp/ArchiveSource.out
echo "package_version $package_version" >> /addon/tmp/ArchiveSource.out

# ============================================================
# Completion
# ============================================================

echo ""
echo "============================================================"
echo "Batch Ingestion Glue Package Build Completed Successfully"
echo "Package: ${packaged_file}"
echo "Version: ${package_version}"
echo "============================================================"
echo "packaged_file $packaged_file" >> /addon/tmp/ArchiveSource.out
echo "package_version $package_version" >> /addon/tmp/ArchiveSource.out
