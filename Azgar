
variable "api_name" {
  description = "Name of the API Gateway REST API"
  type        = string
}

variable "api_description" {
  description = "Description of the REST API"
  type        = string
  default     = "PCI Data Redaction Platform API"
}

variable "stage_name" {
  description = "API Gateway deployment stage"
  type        = string
  default     = "dev"
}

variable "lambda_invoke_arn" {
  description = "Lambda function invoke ARN used by API Gateway"
  type        = string
}

variable "vpc_endpoint_ids" {
  description = "VPC endpoint IDs permitted to access the private API"
  type        = list(string)

  validation {
    condition     = length(var.vpc_endpoint_ids) > 0
    error_message = "At least one VPC endpoint ID is required for a private API."
  }
}

variable "http_methods" {
  description = "HTTP methods exposed by the API"
  type        = set(string)
  default     = ["GET", "POST"]
}

variable "authorization_type" {
  description = "API Gateway method authorization type"
  type        = string
  default     = "NONE"

  validation {
    condition     = contains(["NONE", "AWS_IAM", "CUSTOM", "COGNITO_USER_POOLS"], var.authorization_type)
    error_message = "Choose a supported API Gateway REST API authorization type."
  }
}

variable "tags" {
  description = "Tags applied to API Gateway resources that support tags"
  type        = map(string)
  default     = {}
}
