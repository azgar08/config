locals {
  account_vars     = read_terragrunt_config(find_in_parent_folders("account.hcl"))
  region_vars      = read_terragrunt_config(find_in_parent_folders("region.hcl"))
  environment_vars = read_terragrunt_config(find_in_parent_folders("env.hcl"))

  aws_region     = local.region_vars.locals.aws_region
  environment    = local.environment_vars.locals.environment
  project_name   = local.environment_vars.locals.project_name
  account_name   = local.account_vars.locals.account_name
  module_version = "1.3.0"
}


# Terragrunt will copy the Terraform configurations specified by the source parameter, along with any files in the
# working directory, into a temporary folder, and execute your Terraform commands in that folder.
# !!! CHANGE VALUE HERE FOR EACH FRAMEWORK !!!
terraform {
  source = "git::ssh://git@bitbucket.org:/deluxe-development/dl-aws-auroracleanup//datalake-auroracleanup//?ref=${local.module_version}"
}

# Include all settings from the root terragrunt.hcl file
include "root" {
  path = find_in_parent_folders()
}

dependency "datalake" {
  config_path                             = "${get_terragrunt_dir()}/../../datalake/"
  mock_outputs_allowed_terraform_commands = ["validate", "destroy", "plan-all"]
  mock_outputs = {
    glue_assets_s3_id = "123",
    encyption_kms_arn = "123"
  }
}

dependency "vpc-info" {
  config_path                             = "${get_terragrunt_dir()}/../../../_global/vpc-info"
  mock_outputs_allowed_terraform_commands = ["validate", "destroy", "plan-all"]
  mock_outputs = {
    vpc_id = "123"
  }
}

dependency "lambda-subnets" {
  config_path = "${get_terragrunt_dir()}/../../../_global/lambda-glue-subnets"
}

# These are the variables we have to pass in to use the module specified in the terragrunt configuration above
inputs = {
  aws_region                        = local.aws_region
  environment                       = local.environment
  project_name                      = local.project_name
  account_name                      = local.account_name
  vpc_id                            = dependency.vpc-info.outputs.vpc_id
  subnet_ids                        = dependency.lambda-subnets.outputs.lambda_subnet_ids
  kms_arn                           = dependency.datalake.outputs.encyption_kms_arn
  event_schedule                    = "cron(0 0 ? * * *)"
  lambda_replication_cleanup_name   = "replication-cleanup-lambda"
  lambda_replication_cleanup_layers = ["dbutils-layer-${local.environment}", "notifications-layer-${local.environment}"]
  secret_rds_cfg                    = "dlx-raas-dl-rds-conf-db-config-${local.environment}"
  secret_rds_cert                   = "dlx-raas-rds-etl-db-ssl-cert"
  rds_db_name                       = "r360_v3_${lower(local.environment)}"
  sqs_notification_name             = "${local.project_name}-notifications-queue-${local.environment}"
  lambda_org_purge_name             = "org-purge-lambda"
  lambda_org_purge_layers           = ["dbutils-layer-${local.environment}", "notifications-layer-${local.environment}"]
  function_tags = {
    "Artifact" = "REPLACE"
  }
}
