module "aws_lambda" {
  #depends_on = [module.iam_role]
  source = "git::ssh://git@bitbucket.org/deluxe-development/aws-lambda.git//?ref=1.0.8"
  lambdas = [{
    identifier                        = var.name
    name                              = var.name
    description                       = "${var.name} Function"
    handler                           = var.lambda_handler
    runtime                           = var.lambda_runtime
    memory_size                       = var.lambda_memory_size
    ephemeral_storage_size            = var.lambda_ephemeral_storage_size
    timeout                           = 900
    cloudwatch_logs_retention_in_days = var.lambda_logs_retention_in_days
    iam_role_arn                      = var.iam_role == null ? module.iam_role.iam_role_arn : var.iam_role
    local_existing_package            = var.package_path
    kms_key_arn                       = var.lambda_kms
    vpc_subnet_ids                    = var.vpc_subnet_ids
    vpc_security_group_ids            = var.vpc_security_group_ids
    environment_variables             = var.lambda_environment_variables
    layers = try(coalescelist(var.lambda_layers, var.layers), null)
    allowed_triggers = var.add_trigger ? {
      "${var.TypeofTrigger}" = {
        statement_id = var.statement_id,
        principal    = var.principal,
        source_arn   = var.lambda_trigger
      }
    } : {}
    event_source_mapping = try(var.event_source_mapping, [])
    tags                 = var.tags
    function_tags        = var.function_tags
  }]
}

