                              unzip -o "$src_file" -d /tmp/src/glue

                              test -f /tmp/src/glue/glue_redaction.py
                              test -d /tmp/src/glue/pci_redaction

                              cd /tmp
                              git clone git@bitbucket.org:deluxe-development/infrastructure.raas.terraform.live.git

                              cd /tmp/infrastructure.raas.terraform.live
                              git checkout "<+pipeline.variables.branch_name>"

                              cd "<+pipeline.variables.aws_lz>/<+pipeline.variables.aws_region>/<+pipeline.variables.environment>/pci-redaction/glues/glue-batch-processor"

                              sed -i "s/REPLACE/$src_file/g" terragrunt.hcl

                              terragrunt plan

                              rm -rf /tmp/infrastructure.raas.terraform.live /tmp/src /tmp/unzipped_archive
                              unset AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN TENV_AUTO_INSTALL
                        environmentVariables: []
                        outputVariables: []
                      timeout: 45m

                  - step:
                      type: HarnessApproval
                      name: Redaction Glue Apply Approval
                      identifier: Redaction_Glue_Apply_Approval_Higher
                      spec:
                        approvalMessage: Review and approve the Redaction Batch Ingestion Glue PROD deployment.
                        includePipelineExecutionHistory: true
                        isAutoRejectEnabled: false
                        approvers:
                          userGroups:
                            - R360_Plus_SRE
                          minimumCount: 1
                          disallowPipelineExecutor: false
                        approverInputs: []
                      timeout: 1d
                      when:
                        stageStatus: Success
                        condition: <+pipeline.variables.deploy_action> == "apply"

                  - step:
                      type: HarnessApproval
                      name: Redaction Glue Destroy Approval
                      identifier: Redaction_Glue_Destroy_Approval_Higher
                      spec:
                        approvalMessage: Review and approve the Redaction Batch Ingestion Glue PROD destroy operation.
                        includePipelineExecutionHistory: true
                        isAutoRejectEnabled: false
                        approvers:
                          userGroups:
                            - R360_Plus_SRE
                          minimumCount: 1
                          disallowPipelineExecutor: false
                        approverInputs: []
                      timeout: 1d
                      when:
                        stageStatus: Success
                        condition: <+pipeline.variables.deploy_action> == "destroy"

                  - step:
                      type: ShellScript
                      name: Redaction Glue Terragrunt Apply
                      identifier: Redaction_Glue_Terragrunt_Apply_Higher
                      spec:
                        shell: Bash
                        executionTarget: {}
                        source:
                          type: Inline
                          spec:
                            script: |-
                              set -euo pipefail

                              export TENV_AUTO_INSTALL=true
                              export TERRAGRUNT_TFPATH=tofu

                              ROLE_ARN="arn:aws:iam::908976231039:role/Terraform-Admin-Role"

                              CREDS=$(aws sts assume-role --role-arn "$ROLE_ARN" --role-session-name RedactionGlueApply)

                              export AWS_ACCESS_KEY_ID=$(echo "$CREDS" | jq -r '.Credentials.AccessKeyId')
                              export AWS_SECRET_ACCESS_KEY=$(echo "$CREDS" | jq -r '.Credentials.SecretAccessKey')
