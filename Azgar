```hcl
  # API GATEWAY TRIGGER VARS
  enable_api_gateway_trigger = true

  api_gateway_execution_arn = "arn:aws:execute-api:ap-south-1:123456789012:your-api-id"
  api_gateway_http_method   = "GET"
  api_gateway_resource_path = "*"
```

```hcl
resource "aws_lambda_permission" "api_gateway_trigger" {
  count = var.enable_api_gateway_trigger ? 1 : 0

  statement_id  = "AllowAPIGatewayInvoke-${var.name}"
  action        = "lambda:InvokeFunction"
  function_name = var.name
  principal     = "apigateway.amazonaws.com"

  source_arn = "${var.api_gateway_execution_arn}/*/${var.api_gateway_http_method}/${var.api_gateway_resource_path}"

  depends_on = [module.aws_lambda]
}
```

```hcl
variable "enable_api_gateway_trigger" {
  description = "Enable API Gateway invocation permission"
  type        = bool
  default     = false
}

variable "api_gateway_execution_arn" {
  description = "Execution ARN of the existing API Gateway"
  type        = string
  default     = ""
}

variable "api_gateway_http_method" {
  description = "HTTP method configured in API Gateway"
  type        = string
  default     = "GET"
}

variable "api_gateway_resource_path" {
  description = "API Gateway resource path"
  type        = string
  default     = "*"
}
```
