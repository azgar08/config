
set -e
set +x

# Configure Git safe directory
if command -v git >/dev/null 2>&1; then
  git config --global --add safe.directory '*' || true
fi

# Install required OS packages
apt-get update
apt-get install -y zip unzip curl
apt-get clean
rm -rf /var/lib/apt/lists/*

# Move to module test directory
cd "lambda/<+pipeline.variables.moduleName>/tests"

# Verify Python and pip
python --version
python -m pip --version

# Install application and test dependencies
python -m pip install --no-cache-dir -r ../src/requirements.txt
python -m pip install --no-cache-dir boto3 botocore pytest

# Add src directory so tests can import lambda_function.py
export PYTHONPATH="$(cd ../src && pwd):${PYTHONPATH:-}"

# Verify dependencies and Lambda import
python -c "import boto3, botocore, pytest; print('boto3:', boto3.__version__); print('botocore:', botocore.__version__); print('pytest:', pytest.__version__)"
python -c "from lambda_function import lambda_handler; print('Lambda import successful')"

# Run unit tests
python -m pytest --ignore=bdd --junitxml=junitresult.xml

# Run BDD tests if the directory exists
set +e
if [ -d bdd ]; then
  bdd_test_output=$(python -m pytest bdd --junitxml=<+pipeline.variables.TestResultsFileName> 2>&1)
  bdd_test_exitcd=$?
else
  cp junitresult.xml "<+pipeline.variables.TestResultsFileName>"
  bdd_test_exitcd=0
fi
set -e

# Prepare test report
VortexFilename="result.$(date +"%Y.%m.%d-%H.%M.%S").xml"
cp "<+pipeline.variables.TestResultsFileName>" "$VortexFilename"

ArchiveName="RaaS_<+pipeline.variables.ProjectName>_PreDeploy.zip"
zip -q "$ArchiveName" "<+pipeline.variables.TestResultsFileName>"

# Report Portal access token
AccessToken="<+secrets.getValue("account.ReportPortalHarnessAccessToken")>"

# Report Portal upload (enable if required)
# curl -X POST "<REPORT_PORTAL_UPLOAD_URL>" \
#   -H "Authorization: Bearer ${AccessToken}" \
#   -F "file=@${VortexFilename}"

# Download and extract Zephyr uploader
curl -fsS -o ZephyrUpload-current.tar.gz \
  "https://artifacts.deluxe.com/artifactory/PyPI-Local/ZephyrUpload-<+variable.ZephyrUploadVersion>.tar.gz" \
  -H "Authorization: <+secrets.getValue("account.JFrog_Cloud_API_Token")>"

tar -xzf ZephyrUpload-current.tar.gz

# Install Zephyr uploader dependencies
cd ZephyrUpload-current
python -m pip install --no-cache-dir -r ./ZephyrUpload/requirements.txt

# Upload results to Zephyr
python3 ZephyrUpload \
  "Receivables as a Service (RaaS)\Raas\Automated Pre-Deploy\RaaS-Redaction" \
  -type All \
  -features "../" \
  -junit "../$VortexFilename" \
  -auth "<+secrets.getValue("raas_zephyr_token")>" \
  -userid "<+secrets.getValue("raas_zephyr_userid")>" \
  -noname

cd ..

# Fail the step if BDD tests failed
if [ "$bdd_test_exitcd" -ne 0 ]; then
  echo "$bdd_test_output"
  exit "$bdd_test_exitcd"
fi
