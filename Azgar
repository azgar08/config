
set -euo pipefail

# Assume the TF Role
case <+pipeline.variables.env_delegate> in
    dev-iac-delegate)
        aws_credentials_json=$(aws sts assume-role --role-arn arn:aws:iam::697179190149:role/Terraform-Admin-Role --role-session-name DEVSession)
        ;;
    nonprod-iac-delegate)
        aws_credentials_json=$(aws sts assume-role --role-arn arn:aws:iam::518383396166:role/Terraform-Admin-Role --role-session-name NONPRODSession)
        ;;
    prod-iac-delegate)
        aws_credentials_json=$(aws sts assume-role --role-arn arn:aws:iam::908976231039:role/Terraform-Admin-Role --role-session-name PRODSession)
        ;;
    *)
        echo "Unable to assume role!"
        exit 1
        ;;
esac

export AWS_ACCESS_KEY_ID=$(echo "$aws_credentials_json" | jq -er '.Credentials.AccessKeyId')
export AWS_SECRET_ACCESS_KEY=$(echo "$aws_credentials_json" | jq -er '.Credentials.SecretAccessKey')
export AWS_SESSION_TOKEN=$(echo "$aws_credentials_json" | jq -er '.Credentials.SessionToken')

aws sts get-caller-identity

REGION="<+pipeline.variables.aws_region>"
SECRET_NAME="redaction-database-credentials-<+pipeline.variables.database_user>-<+pipeline.variables.environment>"

HOST="<+pipeline.stages.Read_Existing_RDS_Secret.spec.execution.steps.Read_Existing_RDS_Secret.output.outputVariables.HOST>"
PORT="<+pipeline.stages.Read_Existing_RDS_Secret.spec.execution.steps.Read_Existing_RDS_Secret.output.outputVariables.PORT>"
DATABASE="<+pipeline.variables.database_name>"
DB_USER="<+pipeline.variables.database_user>"

echo "Checking AWS Secrets Manager for existing database user password..."

if aws secretsmanager describe-secret \
    --secret-id "$SECRET_NAME" \
    --region "$REGION" >/dev/null 2>&1; then

    echo "Existing secret found. Retrieving password..."

    SECRET_JSON=$(aws secretsmanager get-secret-value \
        --secret-id "$SECRET_NAME" \
        --region "$REGION" \
        --query SecretString \
        --output text)

    GENERATED_PASSWORD=$(echo "$SECRET_JSON" | jq -er '.password')

    echo "Existing database password reused."

else

    echo "Secret does not exist. Generating password for new database user..."

    GENERATED_PASSWORD=$(openssl rand -base64 32)

    SECRET_JSON=$(jq -n \
        --arg engine "postgres" \
        --arg host "$HOST" \
        --arg port "$PORT" \
        --arg database "$DATABASE" \
        --arg username "$DB_USER" \
        --arg password "$GENERATED_PASSWORD" \
        '{
            engine: $engine,
            host: $host,
            port: $port,
            database: $database,
            username: $username,
            password: $password
        }')

    echo "Creating database credentials secret..."

    aws secretsmanager create-secret \
        --name "$SECRET_NAME" \
        --secret-string "$SECRET_JSON" \
        --region "$REGION"

    echo "New database credentials secret created."

fi

echo "GENERATED_PASSWORD=$GENERATED_PASSWORD"










