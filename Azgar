
resource "aws_lambda_permission" "api_gateway_trigger" {
  for_each = var.enable_api_gateway_trigger ? toset(var.api_gateway_http_methods) : toset([])

  statement_id  = "AllowAPIGatewayInvoke-${var.name}-${each.key}"
  action        = "lambda:InvokeFunction"
  function_name = var.name
  principal     = "apigateway.amazonaws.com"

  source_arn = "${var.api_gateway_execution_arn}/*/${each.key}/*"

  depends_on = [module.aws_lambda]
}



variable "enable_api_gateway_trigger" {
  description = "Enable API Gateway permission to invoke Lambda"
  type        = bool
  default     = false
}

variable "api_gateway_execution_arn" {
  description = "Execution ARN of the API Gateway REST API"
  type        = string
  default     = ""
}

variable "api_gateway_http_methods" {
  description = "HTTP methods allowed to invoke the Lambda"
  type        = list(string)
  default     = ["GET", "POST"]
}



# API GATEWAY TRIGGER VARS
enable_api_gateway_trigger = true

api_gateway_execution_arn = dependency.api-gateway.outputs.execution_arn

api_gateway_http_methods = [
  "GET",
  "POST"
]
