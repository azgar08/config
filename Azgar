
set -euo pipefail

export DEBIAN_FRONTEND=noninteractive

apt-get update
apt-get install -y zip unzip
apt-get clean
rm -rf /var/lib/apt/lists/*

cd glue/<+pipeline.variables.moduleName>

echo "Installing Batch Processor dependencies..."

python -m pip install --no-cache-dir \
  pytest \
  -r requirements.txt

export PYTHONPATH="$PWD/src"

echo "Checking prohibited DynamoDB operations..."

if grep -R -nE '\.(delete_item|describe_time_to_live|update_time_to_live)[[:space:]]*\(' src; then
  echo "Batch processor must not delete DynamoDB records or administer DynamoDB TTL."
  exit 1
fi

echo "Running unit tests..."

set +e
python -m pytest tests/unit -vv -s \
  --junitxml=<+pipeline.variables.TestResultsFileName>

unit_test_exitcd=$?
set -e

echo "Pytest exit code: $unit_test_exitcd"

VortexFilename="result.$(date +"%Y.%m.%d-%H.%M.%S").xml"

if [ -f "<+pipeline.variables.TestResultsFileName>" ]; then
  cp "<+pipeline.variables.TestResultsFileName>" "$VortexFilename"
else
  echo "JUnit report was not generated!"
  exit 1
fi

codebase_branch="<+<+codebase.branch>.substring(0,3)>"

if [ "$codebase_branch" = "dev" ] || [ "$codebase_branch" = "rel" ]; then
  echo "Sending Test Results to TAAS"

  curl -F "exectype=Pre-Deploy" \
       -F "environment=QA" \
       -F "file=@$VortexFilename" \
       -k \
       "<+variable.TestAutomationAnalyticsSystemBaseUrl>/ingestspecflow"
fi

ArchiveName="RaaS_<+pipeline.variables.ProjectName>_PreDeploy.zip"

zip "$ArchiveName" "<+pipeline.variables.TestResultsFileName>"

echo "Uploading test results to Zephyr..."

curl -sO "https://artifacts.deluxe.com/artifactory/PyPI-Local/ZephyrUpload-<+variable.ZephyrUploadVersion>.tar.gz" \
  -H "Authorization: <+secrets.getValue("account.JFrog_Cloud_API_Token")>"

tar -xzf "./ZephyrUpload-<+variable.ZephyrUploadVersion>.tar.gz"

cd "./ZephyrUpload-<+variable.ZephyrUploadVersion>"

pip3 install -r ./ZephyrUpload/requirements.txt

python3 ZephyrUpload \
  "Receivables as a Service (RaaS)\Raas\Automated Pre-Deploy\RaaS-Redaction-Glue" \
  -type All \
  -features "../" \
  -junit "../$VortexFilename" \
  -auth "<+secrets.getValue("raas_zephyr_token")>" \
  -userid "<+secrets.getValue("raas_zephyr_userid")>" \
  -noname

cd ..

if [ "$unit_test_exitcd" -ne 0 ]; then
  exit "$unit_test_exitcd"
fi

echo "Unit tests completed successfully."
