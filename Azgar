
set -e
set +x

# Install OS dependencies
apt-get update && \
apt-get install -y zip unzip && \
apt-get clean

# Navigate to Batch Publishing
cd lambda/batch-publishing

echo "Python version:"
python --version

echo "Installing pytest dependencies..."
python -m pip install pytest boto3 botocore

echo "Installed packages:"
python -m pip list

# Set source directory for test imports
export PYTHONPATH="$PWD/src"

echo "Running unit tests..."
python -m pytest tests --ignore=bdd --junitxml=junitresults.xml

# Generate timestamped test report
VortexFilename="result.$(date +"%Y.%m.%d-%H.%M.%S").xml"
cp junitresults.xml "$VortexFilename"

# Archive JUnit report
ArchiveName="RaaS_BatchPublishing_PreDeploy.zip"

echo "Adding junitresults.xml to archive: $ArchiveName"
zip -q "$ArchiveName" junitresults.xml

echo "Python unit tests completed successfully."
