
set -e
set +x

if [ -x "$(command -v git)" ]; then
  git config --global --add safe.directory '*' || true
fi

# Install OS dependencies
export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y zip unzip
apt-get clean
rm -rf /var/lib/apt/lists/*

# Validate test directory
if [ ! -d lambda/batch-publishing/tests ]; then
  echo "Tests directory not found, creating empty JUnit report."

  cat > junitresult.xml <<EOF
<testsuites>
  <testsuite name="placeholder" tests="0" failures="0" errors="0"/>
</testsuites>
EOF

  cp junitresult.xml junitresults-bdd.xml
  exit 0
fi

# Navigate to tests directory
cd lambda/batch-publishing/tests

echo "Checking for setup-env.sh..."

if [ -f setup-env.sh ]; then
  . ./setup-env.sh setupjava
else
  echo "setup-env.sh not found, skipping..."
fi

# Install test dependencies
echo "Installing test dependencies..."

python -m pip install \
  pytest \
  boto3 \
  jsonschema \
  botocore

# Install application dependencies if available
if [ -f ../requirements.txt ]; then
  echo "Installing batch-publishing requirements..."
  python -m pip install -r ../requirements.txt
elif [ -f ../../../requirements.txt ]; then
  echo "Installing repository requirements..."
  python -m pip install -r ../../../requirements.txt
else
  echo "requirements.txt not found, skipping..."
fi

# Configure Python import path
echo "Setting Python import path..."

export PYTHONPATH="$(pwd)/../src:$(pwd)/..:${PYTHONPATH:-}"

echo "PYTHONPATH=$PYTHONPATH"

# Verify source module
if [ ! -f ../src/lambda_function.py ]; then
  echo "ERROR: ../src/lambda_function.py not found."
  exit 1
fi

python -c "from lambda_function import lambda_handler; print('Lambda import successful')"

# Display installed packages
python -m pip list

# Run unit tests
echo "Running unit tests..."

pytest --ignore=bdd --junitxml=junitresult.xml
UNIT_TEST_EXIT_CODE=$?

# Run BDD tests
if [ -d bdd ]; then
  echo "Running BDD tests..."
  pytest bdd --junitxml=junitresults-bdd.xml
  BDD_TEST_EXIT_CODE=$?
else
  echo "BDD directory not found, reusing unit test results."
  cp junitresult.xml junitresults-bdd.xml
  BDD_TEST_EXIT_CODE=0
fi

# Final status
echo "=================================="
echo "Unit Test Exit Code: $UNIT_TEST_EXIT_CODE"
echo "BDD Test Exit Code: $BDD_TEST_EXIT_CODE"
echo "=================================="

if [ "$UNIT_TEST_EXIT_CODE" -ne 0 ] || [ "$BDD_TEST_EXIT_CODE" -ne 0 ]; then
  exit 1
fi

echo "All tests completed successfully."
