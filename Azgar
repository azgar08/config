echo "Installing ZIP utilities..."
apt-get update
apt-get install -y zip unzip
apt-get clean
rm -rf /var/lib/apt/lists/*

echo "Preparing CPU-only PyTorch requirements..."

TEMP_REQUIREMENTS="$PACKAGE_ROOT/requirements-cpu.txt"

sed 's/^torch==2\.5\.1$/torch==2.5.1+cpu/' \
  "$MODULE_DIR/requirements.txt" > "$TEMP_REQUIREMENTS"

echo "Installing Python dependencies..."

python -m pip install \
  --no-cache-dir \
  --target "$PACKAGE_DIR" \
  --index-url https://download.pytorch.org/whl/cpu \
  --extra-index-url https://pypi.org/simple \
  -r "$TEMP_REQUIREMENTS"

rm -f "$TEMP_REQUIREMENTS"

echo "Validating PyTorch installation..."

PYTHONPATH="$PACKAGE_DIR" python -c \
  "import torch, transformers; print('PyTorch:', torch.__version__); print('CUDA available:', torch.cuda.is_available()); print('Transformers:', transformers.__version__)"

echo "Copying Glue application source..."

cp "$MODULE_DIR/src/glue_redaction.py" "$PACKAGE_DIR/"
cp -R "$MODULE_DIR/src/pci_redaction" "$PACKAGE_DIR/"

echo "Creating deployment ZIP..."

(cd "$PACKAGE_DIR" && zip -1 -q -r "$PACKAGE_ROOT/$packaged_file" . \
  -x "*/__pycache__/*" "*.pyc" "*.pyo")

echo "Validating ZIP..."

unzip -t "$packaged_file" > /dev/null
