resource "aws_lambda_permission" "api_gateway_trigger" {
  for_each = var.enable_api_gateway_trigger ? toset(var.api_gateway_http_methods) : toset([])

  statement_id  = "AllowAPIGatewayInvoke-${var.name}-${each.value}"
  action        = "lambda:InvokeFunction"
  function_name = var.name
  principal     = "apigateway.amazonaws.com"

  source_arn = "${var.api_gateway_execution_arn}/*/${each.value}/${var.api_gateway_resource_path}"

  depends_on = [module.aws_lambda]
}
