locals {
  environment_var   = read_terragrunt_config(find_in_parent_folders("env.hcl"))
  environment       = lower(local.environment_var.locals.infra_environment)
  region_vars       = read_terragrunt_config(find_in_parent_folders("region.hcl"))
  aws_region        = lower(local.region_vars.locals.aws_region)
  account_vars      = read_terragrunt_config(find_in_parent_folders("account.hcl"))
  aws_account_id    = lower(local.account_vars.locals.aws_account_id)
  name              = "dlx-r360plus-execute-api-vpce-${local.environment}"

  source_base_url = "git::ssh://git@bitbucket.org/deluxe-development/infrastructure.raas.terraform.stacks.git//vpc-endpoint"
}

dependency "vpc-info" {
  config_path = find_in_parent_folders("_global/vpc-info")
}

dependency "common-tags" {
  config_path = find_in_parent_folders("common-tags")
}

dependency "pci-subnets" {
  config_path = find_in_parent_folders("_global/pci-subnets")
}

inputs = {
  name   = local.name
  vpc_id = dependency.vpc-info.outputs.vpc_id
  subnet_ids = [
    dependency.pci-subnets.outputs.pci_subnet_ids
  ]

  # Replace with the security group used by your EKS/UI client.
  allowed_client_security_group_ids = [
    dependency.vpc-info.outputs.app_subnets
  ]

  private_dns_enabled = true

  tags = merge(dependency.common-tags.outputs.common_tags, { "TerraformPath" = path_relative_to_include() })
}
