locals {
  account_vars    = read_terragrunt_config(find_in_parent_folders("account.hcl"))
  aws_account_id  = local.account_vars.locals.aws_account_id
  region_vars     = read_terragrunt_config(find_in_parent_folders("region.hcl"))
  aws_region      = local.region_vars.locals.aws_region
  environment_var = read_terragrunt_config(find_in_parent_folders("env.hcl"))
  environment     = lower(local.environment_var.locals.environment)
  name            = "dlx-r360plus-redaction-ui-backend-lambda-${local.environment}"
  rule_name       = "${local.name}-schedule"
  dt_layer_arn    = local.environment_var.locals.dt_layer_arn
  dt_log_endpoint = "https://esn28329.live.dynatrace.com/api/v2/logs/ingest"
  source_base_url = "git::ssh://git@bitbucket.org/deluxe-development/infrastructure.raas.terraform.stacks.git//lambda"
}

dependency "vpc-info" {
  config_path = find_in_parent_folders("_global/vpc-info")
}

dependency "lambda-subnets" {
  config_path = find_in_parent_folders("_global/pci-subnets")
}

dependency "common-tags" {
  config_path = find_in_parent_folders("common-tags")
}

dependency "kms-pci-redaction" {
  config_path = find_in_parent_folders("pci-redaction/kms/kms-pci-redaction")
}

dependency "secret-dynatrace" {
  config_path = find_in_parent_folders("secrets/secret-dynatrace-auth-token")
}

dependency "api-gateway" {
  config_path = find_in_parent_folders("pci-redaction/api-gateway")
}

dependency "s3-pci-ingestion" {
  config_path = find_in_parent_folders("pci-redaction/s3/s3-pci-ingestion")
}

dependency "redaction-batch-metadata" {
  config_path = find_in_parent_folders("pci-redaction/dynamodb/redaction-batch-metadata")
}

dependency "redaction-image-metadata" {
  config_path = find_in_parent_folders("pci-redaction/dynamodb/redaction-image-metadata")
}

dependency "redaction-ui-batch-action-history" {
  config_path = find_in_parent_folders("pci-redaction/dynamodb/redaction-ui-batch-action-history")
}

dependency "redaction-ui-image-action-history" {
  config_path = find_in_parent_folders("pci-redaction/dynamodb/redaction-ui-image-action-history")
}

inputs = {
  name       = local.name
  account_id = local.aws_account_id
  tags = merge(dependency.common-tags.outputs.common_tags, {
    "TerraformPath" = path_relative_to_include()
  })

  #IAM VARS
  policy_statement = templatefile("policy/statement.tftpl", {
    lambda_kms_arn                            = dependency.kms-pci-redaction.outputs.kms_arn,
    dt_secret_arn                             = dependency.secret-dynatrace.outputs.secret_arn,
    dt_secret_kms_arn                         = dependency.secret-dynatrace.outputs.kms_arn,
    s3_pci_ingestion                          = dependency.s3-pci-ingestion .outputs.s3_bucket_arn,
    aws_region                                = local.aws_region,
    environment                               = local.environment,
    aws_account_id                            = local.aws_account_id,
    redact_batch_metadata                     = dependency.redaction-batch-metadata.outputs.dynamodb_table_arn,
    redact_batch_metadata_stream_arn          = dependency.redaction-batch-metadata.outputs.dynamodb_table_name,
    redact_ui_batch_action_history            = dependency.redaction-ui-batch-action-history.outputs.dynamodb_table_arn,
    redact_ui_batch_action_history_stream_arn = dependency.redaction-ui-batch-action-history.outputs.dynamodb_table_name,
    redact_image_metadata                     = dependency.redaction-image-metadata.outputs.dynamodb_table_arn,
    redact_image_metadata_stream_arn          = dependency.redaction-image-metadata.outputs.dynamodb_table_name,
    redact_ui_image_action_history            = dependency.redaction-ui-image-action-history.outputs.dynamodb_table_arn,
    redact_ui_image_action_history_stream_arn = dependency.redaction-ui-image-action-history.outputs.dynamodb_table_name
  })
  trusted_entities = [
    "lambda.amazonaws.com"
  ]

  #LAMBDA VARS
  vpc_subnet_ids = dependency.lambda-subnets.outputs.pci_subnet_ids
  vpc_security_group_ids = [
    dependency.vpc-info.outputs.baseline_sg_id
  ]
  lambda_handler     = "app.handler"
  lambda_key         = dependency.kms-pci-redaction.outputs.kms_arn
  lambda_runtime     = "python3.12"
  lambda_memory_size = 512
  lambda_layers      = [local.dt_layer_arn]
  lambda_environment_variables = {
    REGION                              = local.aws_region
    ENV                                 = local.environment
    DYNAMODB_BATCH_TABLE                = dependency.redaction-batch-metadata.outputs.dynamodb_table_name
    DYNAMODB_IMAGE_TABLE                = dependency.redaction-image-metadata.outputs.dynamodb_table_name
    DYNAMODB_BATCH_ACTION_HISTORY_TABLE = dependency.redaction-ui-batch-action-history.outputs.dynamodb_table_name
    DYNAMODB_IMAGE_ACTION_HISTORY_TABLE = dependency.redaction-ui-image-action-history.outputs.dynamodb_table_name
  }

  # API GATEWAY TRIGGER VARS
  enable_api_gateway_trigger = true

  api_gateway_execution_arn = dependency.api-gateway.outputs.execution_arn
  api_gateway_http_methods = [
  "GET",
  "POST"
]
  api_gateway_resource_path = "*"
}
