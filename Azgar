  glue_security_cfg = var.create_security_cfg ? "${var.glue_job_name[0]}-cfg" : var.glue_security_cfg

  # Extract IAM role name from the role ARN
  glue_role_name = element(
    reverse(split("/", var.glue_job_role_arn)),
    0
  )
}

variable "glue_log_group_retention_days" {
  description = "CloudWatch log group retention period for Glue logs"
  type        = number
  default     = 30
}

### Glue CloudWatch Error Log Group
resource "aws_cloudwatch_log_group" "glue_error" {
  name              = "/aws-glue/python-jobs/${local.glue_security_cfg}/${local.glue_role_name}/error"
  retention_in_days = var.glue_log_group_retention_days
}


### Glue CloudWatch Output Log Group
resource "aws_cloudwatch_log_group" "glue_output" {
  name              = "/aws-glue/python-jobs/${local.glue_security_cfg}/${local.glue_role_name}/output"
  retention_in_days = var.glue_log_group_retention_days
}

glue_log_group_retention_days = 30
