table_policy = [
  {
    sid    = "BatchMetadataFullTableAccess"
    effect = "Allow"

    principals = [
      {
        type = "AWS"
        identifiers = [
          "arn:aws:iam::${local.aws_account_id}:root"
        ]
      }
    ]

    actions = [
      "dynamodb:GetItem",
      "dynamodb:PutItem",
      "dynamodb:UpdateItem",
      "dynamodb:DeleteItem",
      "dynamodb:BatchGetItem",
      "dynamodb:BatchWriteItem",
      "dynamodb:Query",
      "dynamodb:Scan",
      "dynamodb:DescribeTable"
    ]

    resources = [
      local.table_arn,
      "${local.table_arn}/index/*"
    ]

    condition = []
  }
]
