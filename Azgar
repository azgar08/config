variable "enable_api_gateway_trigger" {
  description = "Enable API Gateway trigger for Lambda"
  type        = bool
  default     = false
}

variable "api_gateway_http_methods" {
  description = "HTTP methods allowed for API Gateway"
  type        = list(string)
  default     = ["POST"]
}

variable "api_gateway_execution_arn" {
  description = "API Gateway execution ARN"
  type        = string
  default     = ""
}

variable "api_gateway_resource_path" {
  description = "API Gateway resource path"
  type        = string
  default     = "*"
}
