locals {
  environment_vars  = read_terragrunt_config(find_in_parent_folders("env.hcl"))
  environment       = lower(local.environment_vars.locals.environment)
  region_vars       = read_terragrunt_config(find_in_parent_folders("region.hcl"))
  aws_region        = lower(local.region_vars.locals.aws_region)
  account_vars      = read_terragrunt_config(find_in_parent_folders("account.hcl"))
  aws_account_id    = lower(local.account_vars.locals.aws_account_id)

  source_base_url = "git::ssh://git@bitbucket.org/deluxe-development/infrastructure.raas.terraform.stacks.git//api-gateway-restapi"
}

dependency "common-tags" {
  config_path = find_in_parent_folders("common-tags")
}

dependency "pci-vpc-endpoint" {
  config_path = find_in_parent_folders("_global/pci-vpc-endpoint")
}

inputs = {
  api_name          = "dlx-r360plus-ui-backend-api-${local.environment}"
  api_description   = "UI Backend Platform API"
  stage_name        = "${local.environment}"
  lambda_invoke_arn = "arn:aws:lambda:us-east-1:${local.aws_account_id}:function:dlx-r360plus-redaction-ui-backend-lambda-${local.environment}"
  vpc_endpoint_ids = [
    dependency.pci-vpc-endpoint.outputs.vpc_endpoint_id
  ]

  http_methods = [
    "GET",
    "POST"
  ]

  # Set this according to your approved security design.
  authorization_type = "NONE"

  tags = merge(dependency.common-tags.outputs.common_tags, { "TerraformPath" = path_relative_to_include() })
}
