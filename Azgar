                  - step:
                      type: ShellScript
                      name: Redaction Glue Terragrunt Destroy
                      identifier: Redaction_Glue_Terragrunt_Destroy_Higher
                      spec:
                        shell: Bash
                        executionTarget: {}
                        source:
                          type: Inline
                          spec:
                            script: |-
                              set -euo pipefail

                              export TENV_AUTO_INSTALL=true
                              export TERRAGRUNT_TFPATH=tofu

                              ROLE_ARN="arn:aws:iam::908976231039:role/Terraform-Admin-Role"

                              CREDS=$(aws sts assume-role --role-arn "$ROLE_ARN" --role-session-name RedactionGlueDestroy)

                              export AWS_ACCESS_KEY_ID=$(echo "$CREDS" | jq -r '.Credentials.AccessKeyId')
                              export AWS_SECRET_ACCESS_KEY=$(echo "$CREDS" | jq -r '.Credentials.SecretAccessKey')
