variable "name" {
  description = "Name of the offline stack"
  type        = string
}

variable "environment" {
  description = "Environment name"
  type        = string
}

variable "aws_region" {
  description = "DR/West AWS region"
  type        = string
}

variable "bucket_name" {
  description = "S3 bucket name"
  type        = string
}

variable "domain_name" {
  description = "Offline DNS name"
  type        = string
}

variable "public_route53_zone_id" {
  description = "Public Route53 hosted zone ID"
  type        = string
}

variable "private_route53_zone_id" {
  description = "Private Route53 hosted zone ID"
  type        = string
}

variable "acm_certificate_arn" {
  description = "Existing ACM certificate ARN in us-east-1"
  type        = string
}

variable "tags" {
  description = "Resource tags"
  type        = map(string)
  default     = {}
}
