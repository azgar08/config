
- step:
    type: Run
    name: ArchiveSource
    identifier: ArchiveSource
    spec:
      connectorRef: artifactorydeluxecom
      image: python:3.12
      shell: Bash
      command: |-
        set -e

        apt-get update
        apt-get install -y zip rsync

        export package_version=<+<+codebase.branch>.replaceAll("/","-")>.<+pipeline.variables.packageVersion>.<+pipeline.sequenceId>

        MODULE_DIR="<+pipeline.variables.moduleName>"
        REQUIREMENTS_FILE="$MODULE_DIR/requirements.txt"

        find "$MODULE_DIR/src" -name '*.py' -exec sed -i "/VERSION_NUMBER=/c\VERSION_NUMBER=\"${package_version}\"" {} \;

        export packaged_file="$MODULE_DIR-$package_version.zip"

        pushd "$MODULE_DIR/src/"

        echo "Installing Python dependencies..."

        python -m pip install \
          --no-cache-dir \
          --platform manylinux2014_x86_64 \
          --implementation cp \
          --python-version 3.12 \
          --only-binary=:all: \
          -r "../../$REQUIREMENTS_FILE" \
          -t .

        echo "Copying custom libraries..."
        rsync -r --exclude='*/__pycache__/' ../tests/libs ./

        echo "Creating Lambda deployment package..."
        zip -r --move --test "../../$packaged_file" ./ \
          -x "*/__pycache__/*" "*.pyc"

        popd

        echo "Lambda package ready: $packaged_file"
    outputVariables:
      - name: packaged_file
      - name: package_version
    when:
      stageStatus: Success
    failureStrategies: []
