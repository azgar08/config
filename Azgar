
variable "aws_region" {
  description = "AWS region where the Glue job will be created."
  type        = string
}

variable "environment" {
  description = "Deployment environment."
  type        = string
}

variable "project_name" {
  description = "Project name."
  type        = string
}

variable "account_name" {
  description = "AWS account name."
  type        = string
}

variable "glue_job_name" {
  description = "Glue job name."
  type        = string
}

variable "glue_job_role_arn" {
  description = "IAM role ARN used by the Glue job."
  type        = string
}

variable "s3_glue_bucket" {
  description = "S3 bucket containing Glue scripts, libraries and temporary files."
  type        = string
}

variable "glue_script_key" {
  description = "S3 object key for the Glue Python script."
  type        = string
}

variable "glue_version" {
  description = "AWS Glue version."
  type        = string
  default     = "5.0"
}

variable "python_version" {
  description = "Python version."
  type        = string
  default     = "3"
}

variable "glue_job_execution_class" {
  description = "Glue job execution class."
  type        = string
  default     = "STANDARD"
}

variable "worker_type" {
  description = "Glue worker type."
  type        = string
  default     = "G.1X"
}

variable "number_of_workers" {
  description = "Number of Glue workers."
  type        = number
  default     = 2
}

variable "glue_job_max_concur" {
  description = "Maximum concurrent Glue job runs."
  type        = number
  default     = 1
}

variable "timeout" {
  description = "Glue job timeout in minutes."
  type        = number
  default     = 60
}

variable "max_retries" {
  description = "Maximum number of Glue job retries."
  type        = number
  default     = 0
}

variable "glue_security_cfg" {
  description = "Optional Glue security configuration name."
  type        = string
  default     = ""
}

variable "glue_job_connection" {
  description = "Glue connections to attach to the job."
  type        = list(string)
  default     = []
}

variable "glue_extra_libs" {
  description = "S3 paths to additional Python libraries."
  type        = list(string)
  default     = []
}

variable "glue_driver_env_vars" {
  description = "Optional CUSTOMER_-prefixed Glue driver environment variables."
  type        = map(string)
  default     = {}
}

variable "default_arguments" {
  description = "Additional Glue job arguments."
  type        = map(string)
  default     = {}
}

variable "tags" {
  description = "Resource tags."
  type        = map(string)
  default     = {}
}
