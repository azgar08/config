            tags: {}
            when:
              pipelineStatus: Success
              condition: <+pipeline.variables.aws_lz> == "PROD"

  variables:
    - name: branch_name
      type: String
      description: IaC repository branch
      required: false
      value: <+input>.default(dev-east-1)

    - name: aws_lz
      type: String
      description: AWS landing zone
      value: <+input>.default(DEV).selectOneFrom(DEV,NONPROD,PROD)

    - name: aws_region
      type: String
      description: AWS region
      value: <+input>.default(us-east-1).selectOneFrom(us-east-1,us-west-2)

    - name: environment
      type: String
      description: Deployment environment
      value: <+input>.default(DEV).selectOneFrom(DEV,QA,RC,XUAT,PROD,DR)

    - name: artifactory_url
      type: String
      description: Artifactory base URL
      value: https://artifacts.deluxe.com

    - name: artifactory_repo
      type: String
      description: Artifactory repository
      value: deluxe-raas-dl-local

    - name: package_version
      type: String
      description: CI package version; use NA for trigger package
      value: <+input>

    - name: module_name
      type: String
      description: CI artifact module name
      value: batch-processor

    - name: framework_name
      type: String
      description: CI framework folder in Artifactory
      value: RaaS-Redaction-Glue

    - name: deploy_action
      type: String
      description: Deployment action
      value: <+input>.default(apply).selectOneFrom(apply,destroy)

    - name: trigger_package
      type: String
      description: Exact artifact filename when package_version is NA
      value: <+input>.default(NA)

    - name: env_delegate
      type: String
      description: AWS delegate selector
      value: <+input>.default(dev-iac-delegate).selectOneFrom(dev-iac-delegate,nonprod-iac-delegate,prod-iac-delegate)

  delegateSelectors:
    - <+pipeline.variables.env_delegate>
