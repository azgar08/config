
variable "name" {
  description = "Base DynamoDB table name"
  type        = string
}

variable "hash_key" {
  description = "DynamoDB partition key"
  type        = string
}

variable "range_key" {
  description = "DynamoDB sort key"
  type        = string
  default     = null
}

variable "attributes" {
  description = "DynamoDB table and index attributes"

  type = list(object({
    name = string
    type = string
  }))
}

variable "environment" {
  type = string
}

variable "region" {
  type = string
}

variable "billing_mode" {
  description = "DynamoDB billing mode"
  type        = string
  default     = "PAY_PER_REQUEST"
}

variable "read_capacity" {
  type    = number
  default = null
}

variable "write_capacity" {
  type    = number
  default = null
}

variable "stream_enabled" {
  type    = bool
  default = true
}

variable "stream_view_type" {
  type    = string
  default = "NEW_AND_OLD_IMAGES"
}

variable "server_side_encryption_kms_key_arn" {
  type = string
}

variable "tags" {
  type    = map(string)
  default = {}
}

variable "replica_regions" {
  type    = list(string)
  default = []
}

variable "table_policy" {
  description = "DynamoDB table resource policy"

  type = list(object({
    sid       = string
    actions   = list(string)
    effect    = string
    resources = list(string)

    principals = list(object({
      type        = string
      identifiers = list(string)
    }))

    condition = list(object({
      test     = string
      variable = string
      values   = list(string)
    }))
  }))

  default = []
}

variable "stream_policy" {
  description = "DynamoDB stream resource policy"

  type = list(object({
    sid       = string
    actions   = list(string)
    effect    = string
    resources = list(string)

    principals = list(object({
      type        = string
      identifiers = list(string)
    }))

    condition = list(object({
      test     = string
      variable = string
      values   = list(string)
    }))
  }))

  default = []
}
