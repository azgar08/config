apt-get update
apt-get install -y zip
apt-get install -y rsync

git diff --name-only HEAD HEAD~1

export package_version=<+<+codebase.branch>.replaceAll("/","-")>.<+pipeline.variables.packageVersion>.<+pipeline.sequenceId>                      
find lambda/<+pipeline.variables.moduleName>/src -name '*.py' -exec sed -i "/VERSION_NUMBER=/c\VERSION_NUMBER=\"${package_version}\"" {} \;
echo "Set package version to ${package_version}"

export packaged_file="<+pipeline.variables.moduleName>-$package_version.zip"
pushd lambda/<+pipeline.variables.moduleName>/src/

echo "Copying libs to lambda source code ..."
if [ -d "../tests/libs" ]; then
    echo "Copying libs to lambda source code ..."
    rsync -r --exclude='*/__pycache__/' ../tests/libs/ ./
else
    echo "tests/libs directory not found. Skipping library copy for now."
fi

echo "Archiving lambda source code ..."
zip -r --move --test ../../../$packaged_file ./;
popd

echo "Package file $packaged_file is ready to be pushed into Artifactory!"
