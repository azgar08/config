cd lambda/<+pipeline.variables.moduleName>/tests

echo "Python version:"
python --version

echo "Installing dependencies..."
python -m pip install --no-cache-dir \
  -r ../src/requirements.txt \
  boto3 \
  botocore \
  pytest

echo "Verifying AWS SDK..."
python -c "import boto3, botocore; print('boto3:', boto3.__version__); print('botocore:', botocore.__version__)"

echo "Running unit tests..."
python -m pytest --ignore=bdd --junitxml=junitresult.xml
