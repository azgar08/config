locals {

  env = read_terragrunt_config("env.hcl")

}


terraform {

  source = "git::ssh://git@bitbucket.org/<YOUR-ORG>/terraform-stack-offline-page.git//.?ref=v1.0.0"

}


include "root" {

  path = find_in_parent_folders("root.hcl")

}


inputs = {

  name = local.env.locals.name

  environment = local.env.locals.environment

  aws_region = local.env.locals.aws_region

  bucket_name = local.env.locals.bucket_name

  domain_name = local.env.locals.domain_name

  public_route53_zone_id =
    local.env.locals.public_route53_zone_id

  private_route53_zone_id =
    local.env.locals.private_route53_zone_id

  acm_certificate_arn =
    local.env.locals.acm_certificate_arn

  tags = local.env.locals.tags

}
