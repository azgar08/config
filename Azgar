set -euo pipefail

apt-get update
apt-get install -y zip
apt-get clean
rm -rf /var/lib/apt/lists/*

export package_version="<+<+codebase.branch>.replaceAll("/","-")>.<+pipeline.variables.packageVersion>.<+pipeline.sequenceId>"

MODULE_DIR="glue/<+pipeline.variables.moduleName>"
PACKAGE_ROOT="$PWD"
PACKAGE_DIR="$(mktemp -d)"

export packaged_file="<+pipeline.variables.moduleName>-${package_version}.zip"

trap 'rm -rf "$PACKAGE_DIR"' EXIT

echo "Installing runtime dependencies..."

python -m pip install \
  --no-cache-dir \
  --target "$PACKAGE_DIR" \
  -r "$MODULE_DIR/requirements.txt"

echo "Copying Glue application source..."

cp "$MODULE_DIR/src/glue_redaction.py" "$PACKAGE_DIR/"

cp -R "$MODULE_DIR/src/pci_redaction" "$PACKAGE_DIR/"

echo "Creating deployment ZIP..."

(cd "$PACKAGE_DIR" && zip -r "$PACKAGE_ROOT/$packaged_file" . \
  -x "*/__pycache__/*" "*.pyc")

echo "Validating deployment ZIP..."

unzip -t "$packaged_file"

echo "Package: $packaged_file"
echo "Version: $package_version"
