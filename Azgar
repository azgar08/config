
#!/usr/bin/env bash
set -euo pipefail

echo "========== R360+ Glue ArchiveSource Started =========="

# --------------------------------------------------
# Configuration
# --------------------------------------------------

REPO_ROOT="$(pwd)"
MODULE_DIR="$REPO_ROOT/glue/batch-ingestion"
SRC_DIR="$MODULE_DIR/src"

PACKAGE_VERSION="<+<+codebase.branch>.replaceAll(\"/\",\"-\")>.<+pipeline.variables.packageVersion>.<+pipeline.sequenceId>"

PACKAGED_FILE="batch-ingestion-${PACKAGE_VERSION}.zip"

WORK_DIR="/tmp/batch-ingestion-package"
PACKAGE_DIR="$WORK_DIR/package"
LIBRARY_DIR="$PACKAGE_DIR/library"
STAGE_DIR="$WORK_DIR/stage"

INGESTION_ZIP="$STAGE_DIR/ingestion.zip"
OUTPUT_FILE="$REPO_ROOT/$PACKAGED_FILE"

# --------------------------------------------------
# Validate source
# --------------------------------------------------

test -f "$MODULE_DIR/setup.py" || {
    echo "ERROR: setup.py not found"
    exit 1
}

test -f "$SRC_DIR/spark_job.py" || {
    echo "ERROR: spark_job.py not found"
    exit 1
}

test -d "$SRC_DIR/ingestion" || {
    echo "ERROR: ingestion package not found"
    exit 1
}

# --------------------------------------------------
# Clean previous build
# --------------------------------------------------

rm -rf "$WORK_DIR"
rm -f "$OUTPUT_FILE"

mkdir -p "$LIBRARY_DIR" "$STAGE_DIR"

# --------------------------------------------------
# Verify Python and packaging tools
# --------------------------------------------------

python3.11 --version
python3.11 -m pip --version

command -v zip >/dev/null
command -v unzip >/dev/null

# --------------------------------------------------
# Install setup.py and dependencies
# --------------------------------------------------

echo "Installing application dependencies"

python3.11 -m pip install \
    --target "$LIBRARY_DIR" \
    --no-cache-dir \
    --no-compile \
    --no-warn-script-location \
    "$MODULE_DIR"

# --------------------------------------------------
# Verify jsonschema and registry compatibility
# --------------------------------------------------

echo "Validating jsonschema"

PYTHONPATH="$LIBRARY_DIR" python3.11 - <<'PY'
import jsonschema
import inspect
from jsonschema import Draft202012Validator

print("jsonschema version:", jsonschema.__version__)

if "registry" not in inspect.signature(
    Draft202012Validator
).parameters:
    raise RuntimeError(
        "Draft202012Validator does not support registry"
    )

print("Registry compatibility verified")
PY

# --------------------------------------------------
# Remove runtime dependencies from ZIP
# These must load from Glue runtime
# --------------------------------------------------

echo "Excluding referencing and rpds-py"

rm -rf "$LIBRARY_DIR/referencing"
rm -rf "$LIBRARY_DIR/rpds"
rm -rf "$LIBRARY_DIR/rpds_py"

rm -rf "$LIBRARY_DIR"/referencing-*.dist-info
rm -rf "$LIBRARY_DIR"/rpds_py-*.dist-info
rm -rf "$LIBRARY_DIR"/rpds-*.dist-info

# --------------------------------------------------
# Create ingestion.zip
# --------------------------------------------------

echo "Creating ingestion.zip"

cd "$LIBRARY_DIR"

zip -qr "$INGESTION_ZIP" .

# --------------------------------------------------
# Validate ingestion.zip
# --------------------------------------------------

echo "Validating ingestion.zip"

if unzip -Z1 "$INGESTION_ZIP" |
   grep -E '^(referencing/|rpds/|rpds_py/)'; then

    echo "ERROR: referencing/rpds found in ZIP"
    exit 1
fi

for REQUIRED in \
    "ingestion/dataguard/" \
    "jsonschema/__init__.py" \
    "jsonschema_specifications/" \
    "pg8000/"
do
    if ! unzip -Z1 "$INGESTION_ZIP" | grep -q "^${REQUIRED}"; then
        echo "ERROR: Missing required package: $REQUIRED"
        exit 1
    fi
done

echo "ingestion.zip validation successful"

# --------------------------------------------------
# Create final artifact
# --------------------------------------------------

echo "Creating final deployment artifact"

cp "$SRC_DIR/spark_job.py" "$STAGE_DIR/spark_job.py"

cd "$STAGE_DIR"

zip -qr "$OUTPUT_FILE" \
    spark_job.py \
    ingestion.zip

# --------------------------------------------------
# Final artifact validation
# --------------------------------------------------

if [ ! -s "$OUTPUT_FILE" ]; then
    echo "ERROR: Final artifact is empty"
    exit 1
fi

echo "========== Artifact Details =========="
echo "Package version : $PACKAGE_VERSION"
echo "Package file    : $PACKAGED_FILE"
echo "Package size    : $(du -h "$OUTPUT_FILE" | cut -f1)"
echo "======================================"

# --------------------------------------------------
# Harness output variables
# --------------------------------------------------

mkdir -p /addon/tmp

echo "packaged_file=$PACKAGED_FILE" \
    >> /addon/tmp/ArchiveSource.out

echo "package_version=$PACKAGE_VERSION" \
    >> /addon/tmp/ArchiveSource.out

echo "========== ArchiveSource Completed Successfully =========="
