
locals {
  account_vars = read_terragrunt_config(
    find_in_parent_folders("account.hcl")
  )

  aws_account_id = local.account_vars.locals.aws_account_id

  region_vars = read_terragrunt_config(
    find_in_parent_folders("region.hcl")
  )

  aws_region = local.region_vars.locals.aws_region

  environment_var = read_terragrunt_config(
    find_in_parent_folders("env.hcl")
  )

  environment = lower(local.environment_var.locals.environment)

  name = "dlx-r360plus-redaction-batch-initiator"

  table_name = "${local.name}-${local.aws_region}-${local.environment}"

  table_arn = "arn:aws:dynamodb:${local.aws_region}:${local.aws_account_id}:table/${local.table_name}"

  source_base_url = "git::ssh://git@bitbucket.org/deluxe-development/infrastructure.raas.terraform.stacks.git//dynamodb"
}

terraform {
  source = "${local.source_base_url}"
}

dependency "common-tags" {
  config_path = find_in_parent_folders("common-tags")
}

dependency "kms-pci-redaction" {
  config_path = find_in_parent_folders("pci-redaction/kms/kms-pci-redaction")
}

inputs = {
  name        = local.name
  environment = local.environment
  region      = local.aws_region

  # Primary key
  hash_key  = "batchID"
  range_key = "ingestionDate"

  # On-demand billing
  billing_mode  = "PAY_PER_REQUEST"
  read_capacity = null
  write_capacity = null

  # Table attributes and GSI attributes
  attributes = [
    {
      name = "batchID"
      type = "S"
    },
    {
      name = "ingestionDate"
      type = "S"
    },
    {
      name = "status"
      type = "S"
    },
    {
      name = "entity_type"
      type = "S"
    }
  ]

  # Encryption
  server_side_encryption_kms_key_arn = dependency.kms-pci-redaction.outputs.kms_arn

  # DynamoDB Streams
  stream_enabled   = true
  stream_view_type = "NEW_AND_OLD_IMAGES"

  # No cross-region replicas currently
  replica_regions = []

  # Table policy
  # Replace the placeholder with the actual application IAM role ARN.
  table_policy = [
    {
      sid    = "BatchInitiatorTableAccess"
      effect = "Allow"

      principals = [
        {
          type = "AWS"
          identifiers = [
            "arn:aws:iam::697179190149:role/REPLACE_WITH_APPLICATION_ROLE"
          ]
        }
      ]

      actions = [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:Query",
        "dynamodb:BatchGetItem",
        "dynamodb:BatchWriteItem"
      ]

      resources = [
        local.table_arn,
        "${local.table_arn}/index/*"
      ]

      condition = []
    }
  ]

  # Stream policy
  # Replace the placeholder with the actual consumer IAM role ARN.
  stream_policy = [
    {
      sid    = "BatchInitiatorStreamAccess"
      effect = "Allow"

      principals = [
        {
          type = "AWS"
          identifiers = [
            "arn:aws:iam::697179190149:role/REPLACE_WITH_STREAM_CONSUMER_ROLE"
          ]
        }
      ]

      actions = [
        "dynamodb:DescribeStream",
        "dynamodb:GetRecords",
        "dynamodb:GetShardIterator",
        "dynamodb:ListStreams"
      ]

      resources = [
        "${local.table_arn}/stream/*"
      ]

      condition = []
    }
  ]

  # Common tags
  tags = merge(
    dependency.common-tags.outputs.common_tags,
    {
      TerraformPath = path_relative_to_include()
    }
  )
}
