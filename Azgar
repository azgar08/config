"""
constants.py
------------
Configuration constants for the Publishing Glue Job Lambda.
Environment variables are the source of truth — constants are fallback defaults only.

Only two things are needed:
  1. Which Glue job to trigger   → DEFAULT_GLUE_JOB_NAME
  2. How to validate the batchId → BATCH_ID_MAX_LENGTH
"""

import os

# ─────────────────────────────────────────────
# Glue Job Config
# ─────────────────────────────────────────────
# job_name is ALWAYS read from this env var.
# Callers cannot override it from the event.
# ─────────────────────────────────────────────

DEFAULT_GLUE_JOB_NAME = os.environ["GLUE_JOB_NAME"]

# ─────────────────────────────────────────────
# Batch ID Validation
# ─────────────────────────────────────────────
# batchId must:
#   - not exceed BATCH_ID_MAX_LENGTH characters
#   - match alphanumeric + hyphens + underscores only (enforced in lambda_function.py)
# ─────────────────────────────────────────────
BATCH_ID_MAX_LENGTH = 100




"""
lambda_function.py
------------------
Publishing Glue Job Trigger - Production Lambda.

Accepts only:
    { "batchId": "publishing_test_10" }

job_name is locked to DEFAULT_GLUE_JOB_NAME env var.
Callers cannot override it from the event.
"""

import json
import logging
import os
import re
import boto3
from botocore.exceptions import ClientError

from constants import (
    DEFAULT_GLUE_JOB_NAME,
    BATCH_ID_MAX_LENGTH,
)

# ─────────────────────────────────────────────
# Logger - structured JSON for CloudWatch Insights
# ─────────────────────────────────────────────
logger = logging.getLogger()
logger.setLevel(logging.INFO)


def log(level: str, message: str, **kwargs):
    entry = {"level": level, "message": message, **kwargs}
    getattr(logger, level.lower())(json.dumps(entry))


# ─────────────────────────────────────────────
# Glue client - module level (reused on warm starts)
# Lambda automatically runs in the correct region
# ─────────────────────────────────────────────
glue_client = boto3.client("glue")


# ─────────────────────────────────────────────
# Regex - batchId safe characters only
# ─────────────────────────────────────────────
BATCH_ID_PATTERN = re.compile(r"^[a-zA-Z0-9_\-]{1,100}$")


# ─────────────────────────────────────────────
# Validation
# ─────────────────────────────────────────────
def validate_batch_id(batch_id: str) -> None:
    """
    Validates batchId - 3 rules only:
      1. Must be a non-empty string
      2. Must match safe alphanumeric pattern (blocks injection)
      3. Must not exceed max length
    """
    if not batch_id or not isinstance(batch_id, str):
        raise ValueError("batchId is required and must be a non-empty string.")

    if len(batch_id) > BATCH_ID_MAX_LENGTH:
        raise ValueError(
            f"batchId exceeds max length of {BATCH_ID_MAX_LENGTH} characters."
        )

    if not BATCH_ID_PATTERN.match(batch_id):
        raise ValueError(
            f"Invalid batchId format: '{batch_id}'. "
            "Only alphanumeric characters, hyphens, and underscores are allowed."
        )


def validate_event(event: dict) -> str:
    """
    Validates the incoming event and returns the batchId.

    Only accepted event shape:
        { "batchId": "publishing_test_10" }

    Any extra keys are silently ignored - not passed to Glue.
    Returns the validated batchId string.
    """
    if not isinstance(event, dict):
        raise ValueError(
            f"Event must be a JSON object, got: {type(event).__name__}"
        )

    batch_id = event.get("batchId", "")
    validate_batch_id(batch_id)

    return batch_id


# ─────────────────────────────────────────────
# Handler
# ─────────────────────────────────────────────
def lambda_handler(event: dict, context) -> dict:
    """
    Entry point for the Publishing Glue Job Lambda.

    Accepted event:
        { "batchId": "publishing_test_10" }

    job_name is always read from DEFAULT_GLUE_JOB_NAME env var.
    Callers cannot override it.
    """
    request_id = getattr(context, "aws_request_id", "local") if context else "local"
    log("info", "Lambda invoked", request_id=request_id)

    # ── 1. Validate ────────────────────────────────────────────────────
    try:
        batch_id = validate_event(event)
    except ValueError as e:
        log("error", "Validation failed", error=str(e))
        return {
            "statusCode": 400,
            "body": json.dumps({"error": "Validation error", "detail": str(e)})
        }

    job_name = DEFAULT_GLUE_JOB_NAME   # ← always from env var, never from caller
    log("info", "Validation passed", job_name=job_name, batch_id=batch_id)

    # ── 2. Start Glue job ──────────────────────────────────────────────
    # No Timeout / MaxCapacity override - Glue job config defines those
    # --batch_id and DynamoDB table env vars are passed as Glue job arguments
    log("info", "Starting Glue job", job_name=job_name, batch_id=batch_id)

    try:
        response = glue_client.start_job_run(
            JobName=job_name,
            Arguments={
                "--batch_id":                   batch_id,
                "--PUBLISH_BATCH_TABLE":        os.environ["PUBLISH_BATCH_TABLE"],
                "--PUBLISH_IMAGE_TABLE":        os.environ["PUBLISH_IMAGE_TABLE"],
                "--PUBLISH_BATCH_STATUS":       os.environ["PUBLISH_BATCH_STATUS"],
                "--PUBLISH_BATCH_STATUS_INDEX": os.environ["PUBLISH_BATCH_STATUS_INDEX"]
            }
        )

    except ClientError as e:
        error_code = e.response["Error"]["Code"]
        error_msg  = e.response["Error"]["Message"]
        log("error", "Glue job start failed",
            error_code=error_code, detail=error_msg, batch_id=batch_id)

        status_map = {
            "EntityNotFoundException":               404,
            "InvalidInputException":                 400,
            "ConcurrentRunsExceededException":       429,
            "ResourceNumberLimitExceededException":  429,
        }
        return {
            "statusCode": status_map.get(error_code, 500),
            "body": json.dumps({
                "error":      error_code,
                "detail":     error_msg,
                "batch_id":   batch_id,
                "request_id": request_id
            })
        }

    # ← catches anything that is not a ClientError
    # e.g. network timeout, boto3 config error, unexpected SDK behaviour
    except Exception as e:
        log("error", "Unexpected error starting Glue job",
            error=str(e), batch_id=batch_id, request_id=request_id)
        return {
            "statusCode": 500,
            "body": json.dumps({
                "error":      "UnexpectedError",
                "detail":     str(e),
                "batch_id":   batch_id,
                "request_id": request_id
            })
        }

    job_run_id = response["JobRunId"]
    log("info", "Glue job started successfully",
        job_name=job_name, job_run_id=job_run_id, batch_id=batch_id)

    # ── 3. Return ──────────────────────────────────────────────────────
    return {
        "statusCode": 200,
        "body": json.dumps({
            "message":    "Glue job started successfully",
            "job_name":   job_name,
            "job_run_id": job_run_id,
            "batch_id":   batch_id,
            "request_id": request_id
        })
    }

"""
test_lambda.py
--------------
Unit tests for the Publishing Glue Job Lambda.
Covers: success, batchId validation, Glue errors, and unexpected errors.
"""

import json
import unittest
from unittest.mock import patch, MagicMock
from botocore.exceptions import ClientError
import sys
import os

sys.path.insert(
    0,
    os.path.join(os.path.dirname(__file__), "../../src/files")
)

from lambda_function import lambda_handler


# ─────────────────────────────────────────────
# Helpers
# ─────────────────────────────────────────────
def make_context(request_id="test-request-id"):
    ctx = MagicMock()
    ctx.aws_request_id = request_id
    return ctx


def make_client_error(code: str, message: str = "Glue error"):
    return ClientError(
        {"Error": {"Code": code, "Message": message}},
        "StartJobRun"
    )


# ─────────────────────────────────────────────
# Test Suite
# ─────────────────────────────────────────────
@patch("lambda_function.glue_client")
class TestLambdaHandler(unittest.TestCase):

    # ── Success ───────────────────────────────────────────────────────

    def test_success(self, mock_glue):
        """Valid batchId triggers Glue job and returns 200."""
        mock_glue.start_job_run.return_value = {"JobRunId": "jr_123"}

        result = lambda_handler({"batchId": "publishing_test_10"}, make_context())

        self.assertEqual(result["statusCode"], 200)
        body = json.loads(result["body"])
        self.assertEqual(body["job_run_id"], "jr_123")
        self.assertEqual(body["batch_id"], "publishing_test_10")
        mock_glue.start_job_run.assert_called_once()

    def test_glue_receives_only_batch_id_argument(self, mock_glue):
        """Glue must receive exactly --batch_id and nothing else."""
        mock_glue.start_job_run.return_value = {"JobRunId": "jr_456"}

        lambda_handler({"batchId": "publishing_test_10"}, make_context())

        call_kwargs = mock_glue.start_job_run.call_args.kwargs
        self.assertEqual(
            call_kwargs["Arguments"],
            {"--batch_id": "publishing_test_10"}
        )

    def test_job_name_not_overridable_from_event(self, mock_glue):
        """Caller cannot override job_name — must always come from env var."""
        mock_glue.start_job_run.return_value = {"JobRunId": "jr_789"}

        lambda_handler(
            {"batchId": "publishing_test_10", "job_name": "malicious-job"},
            make_context()
        )

        call_kwargs = mock_glue.start_job_run.call_args.kwargs
        self.assertNotEqual(call_kwargs.get("JobName"), "malicious-job")

    def test_context_none_does_not_crash(self, mock_glue):
        """Lambda must handle context=None gracefully (local testing)."""
        mock_glue.start_job_run.return_value = {"JobRunId": "jr_000"}

        result = lambda_handler({"batchId": "publishing_local_1"}, None)
        self.assertEqual(result["statusCode"], 200)

    def test_extra_event_keys_are_ignored(self, mock_glue):
        """Extra keys in event must be silently ignored, not passed to Glue."""
        mock_glue.start_job_run.return_value = {"JobRunId": "jr_111"}

        result = lambda_handler(
            {
                "batchId":       "publishing_test_10",
                "total_records": 45000000,           # old field — ignored
                "arguments":     {"--env": "prod"}   # removed field — ignored
            },
            make_context()
        )

        self.assertEqual(result["statusCode"], 200)
        call_kwargs = mock_glue.start_job_run.call_args.kwargs
        self.assertEqual(
            call_kwargs["Arguments"],
            {"--batch_id": "publishing_test_10"}
        )

    def test_success_response_shape(self, mock_glue):
        """Success response must contain all expected fields."""
        mock_glue.start_job_run.return_value = {"JobRunId": "jr_222"}

        result = lambda_handler({"batchId": "publishing_test_10"}, make_context())
        body = json.loads(result["body"])

        self.assertIn("message",    body)
        self.assertIn("job_name",   body)
        self.assertIn("job_run_id", body)
        self.assertIn("batch_id",   body)
        self.assertIn("request_id", body)


    # ── batchId Validation ────────────────────────────────────────────

    def test_missing_batch_id(self, mock_glue):
        """Missing batchId must return 400."""
        result = lambda_handler({}, make_context())
        self.assertEqual(result["statusCode"], 400)
        self.assertIn("batchId", json.loads(result["body"])["detail"])

    def test_empty_batch_id(self, mock_glue):
        """Empty string batchId must return 400."""
        result = lambda_handler({"batchId": ""}, make_context())
        self.assertEqual(result["statusCode"], 400)

    def test_batch_id_special_characters(self, mock_glue):
        """batchId with special characters must return 400."""
        result = lambda_handler(
            {"batchId": "publishing_test; DROP TABLE"},
            make_context()
        )
        self.assertEqual(result["statusCode"], 400)

    def test_batch_id_too_long(self, mock_glue):
        """batchId exceeding 100 characters must return 400."""
        long_id = "a" * 101
        result = lambda_handler({"batchId": long_id}, make_context())
        self.assertEqual(result["statusCode"], 400)

    def test_event_not_a_dict(self, mock_glue):
        """Non-dict event must return 400."""
        result = lambda_handler("not-a-dict", make_context())
        self.assertEqual(result["statusCode"], 400)

    def test_batch_id_not_a_string(self, mock_glue):
        """batchId as integer must return 400."""
        result = lambda_handler({"batchId": 12345}, make_context())
        self.assertEqual(result["statusCode"], 400)

    def test_validation_does_not_call_glue(self, mock_glue):
        """Glue must never be called when validation fails."""
        lambda_handler({"batchId": ""}, make_context())
        mock_glue.start_job_run.assert_not_called()


    # ── Glue ClientError scenarios ────────────────────────────────────

    def test_glue_job_not_found(self, mock_glue):
        """EntityNotFoundException must return 404."""
        mock_glue.start_job_run.side_effect = make_client_error(
            "EntityNotFoundException", "Job not found"
        )
        result = lambda_handler({"batchId": "publishing_test_10"}, make_context())
        self.assertEqual(result["statusCode"], 404)

    def test_glue_invalid_input(self, mock_glue):
        """InvalidInputException must return 400."""
        mock_glue.start_job_run.side_effect = make_client_error(
            "InvalidInputException", "Bad argument"
        )
        result = lambda_handler({"batchId": "publishing_test_10"}, make_context())
        self.assertEqual(result["statusCode"], 400)

    def test_glue_concurrent_runs_exceeded(self, mock_glue):
        """ConcurrentRunsExceededException must return 429."""
        mock_glue.start_job_run.side_effect = make_client_error(
            "ConcurrentRunsExceededException"
        )
        result = lambda_handler({"batchId": "publishing_test_10"}, make_context())
        self.assertEqual(result["statusCode"], 429)

    def test_glue_resource_limit_exceeded(self, mock_glue):
        """ResourceNumberLimitExceededException must return 429."""
        mock_glue.start_job_run.side_effect = make_client_error(
            "ResourceNumberLimitExceededException"
        )
        result = lambda_handler({"batchId": "publishing_test_10"}, make_context())
        self.assertEqual(result["statusCode"], 429)

    def test_glue_unknown_error_returns_500(self, mock_glue):
        """Any unmapped Glue ClientError must return 500."""
        mock_glue.start_job_run.side_effect = make_client_error(
            "InternalServiceException", "Glue internal error"
        )
        result = lambda_handler({"batchId": "publishing_test_10"}, make_context())
        self.assertEqual(result["statusCode"], 500)

    def test_error_response_contains_batch_id(self, mock_glue):
        """Error response body must always include batch_id for traceability."""
        mock_glue.start_job_run.side_effect = make_client_error(
            "EntityNotFoundException"
        )
        result = lambda_handler({"batchId": "publishing_test_10"}, make_context())
        body = json.loads(result["body"])
        self.assertEqual(body["batch_id"], "publishing_test_10")


    # ── Unexpected / generic errors ───────────────────────────────────

    def test_unexpected_exception_returns_500(self, mock_glue):
        """Non-ClientError exceptions must be caught and return 500."""
        mock_glue.start_job_run.side_effect = Exception("Unexpected SDK failure")

        result = lambda_handler({"batchId": "publishing_test_10"}, make_context())

        self.assertEqual(result["statusCode"], 500)
        body = json.loads(result["body"])
        self.assertEqual(body["error"], "UnexpectedError")
        self.assertIn("Unexpected SDK failure", body["detail"])

    def test_unexpected_exception_contains_batch_id(self, mock_glue):
        """Unexpected error response must still include batch_id for traceability."""
        mock_glue.start_job_run.side_effect = Exception("Network timeout")

        result = lambda_handler({"batchId": "publishing_test_10"}, make_context())

        body = json.loads(result["body"])
        self.assertEqual(body["batch_id"], "publishing_test_10")


if __name__ == "__main__":
    unittest.main()


