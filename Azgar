
output "dynamodb_table_name" {
  description = "DynamoDB table name"
  value       = aws_dynamodb_table.this.name
}

output "dynamodb_table_arn" {
  description = "DynamoDB table ARN"
  value       = aws_dynamodb_table.this.arn
}

output "dynamodb_table_id" {
  description = "DynamoDB table ID"
  value       = aws_dynamodb_table.this.id
}

output "dynamodb_table_hash_key" {
  description = "DynamoDB partition key"
  value       = aws_dynamodb_table.this.hash_key
}

output "dynamodb_table_range_key" {
  description = "DynamoDB sort key"
  value       = aws_dynamodb_table.this.range_key
}

output "dynamodb_table_stream_arn" {
  description = "DynamoDB Stream ARN"
  value       = aws_dynamodb_table.this.stream_arn
}

output "dynamodb_stream_enabled" {
  description = "DynamoDB Stream enabled status"
  value       = aws_dynamodb_table.this.stream_enabled
}

output "dynamodb_stream_view_type" {
  description = "DynamoDB Stream view type"
  value       = aws_dynamodb_table.this.stream_view_type
}

output "dynamodb_table_policy_id" {
  description = "DynamoDB table resource policy ID"
  value       = try(aws_dynamodb_resource_policy.table_policy[0].id, null)
}

output "dynamodb_stream_policy_id" {
  description = "DynamoDB stream resource policy ID"
  value       = try(aws_dynamodb_resource_policy.stream_policy[0].id, null)
}
