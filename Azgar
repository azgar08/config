  pytest \
  -r requirements.txt


cd glue/<+pipeline.variables.moduleName>

echo "Installing Batch Processor dependencies..."

python -m pip install --no-cache-dir \
  pytest \
  -r requirements.txt

export PYTHONPATH="$PWD/src"

echo "Checking prohibited DynamoDB operations..."

if grep -R -nE '\.(delete_item|describe_time_to_live|update_time_to_live)[[:space:]]*\(' src; then
  echo "Batch processor must not delete DynamoDB records or administer DynamoDB TTL."
  exit 1
fi

echo "Running unit tests..."

pytest tests/unit -vv -s \
  --junitxml=<+pipeline.variables.TestResultsFileName>
