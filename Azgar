
output "glue_job_name" {
  description = "Created Glue job name."
  value       = aws_glue_job.this.name
}

output "glue_job_arn" {
  description = "Created Glue job ARN."
  value       = aws_glue_job.this.arn
}

output "glue_job_role_arn" {
  description = "IAM role ARN attached to the Glue job."
  value       = aws_glue_job.this.role_arn
}

output "glue_job_execution_class" {
  description = "Glue job execution class."
  value       = aws_glue_job.this.execution_class
}

output "glue_script_location" {
  description = "S3 location of the Glue Python script."
  value       = aws_glue_job.this.command[0].script_location
}
