{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DynamoDBTableAccess",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:Query",
        "dynamodb:BatchGetItem",
        "dynamodb:BatchWriteItem"
      ],
      "Resource": [
        "arn:aws:dynamodb:us-east-1:697179190149:table/dlx-r360plus-redaction-batch-initiator-us-east-1-dev",
        "arn:aws:dynamodb:us-east-1:697179190149:table/dlx-r360plus-redaction-batch-initiator-us-east-1-dev/index/*"
      ]
    },
    {
      "Sid": "DynamoDBStreamReadAccess",
      "Effect": "Allow",
      "Action": [
        "dynamodb:DescribeStream",
        "dynamodb:GetRecords",
        "dynamodb:GetShardIterator"
      ],
      "Resource": "arn:aws:dynamodb:us-east-1:697179190149:table/dlx-r360plus-redaction-batch-initiator-us-east-1-dev/stream/*"
    },
    {
      "Sid": "DynamoDBListStreamsAccess",
      "Effect": "Allow",
      "Action": "dynamodb:ListStreams",
      "Resource": "*"
    }
  ]
}
