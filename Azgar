output "offline_url" {
  description = "Offline URL"

  value = "https://${var.domain_name}"
}

output "s3_bucket_name" {
  description = "S3 bucket name"

  value = aws_s3_bucket.offline.id
}

output "s3_bucket_arn" {
  description = "S3 bucket ARN"

  value = aws_s3_bucket.offline.arn
}

output "cloudfront_distribution_id" {
  description = "CloudFront distribution ID"

  value = aws_cloudfront_distribution.offline.id
}

output "cloudfront_domain_name" {
  description = "CloudFront domain name"

  value = aws_cloudfront_distribution.offline.domain_name
}

output "public_dns_name" {
  description = "Public Route53 record"

  value = aws_route53_record.offline_public.name
}

output "private_dns_name" {
  description = "Private Route53 record"

  value = aws_route53_record.offline_private.name
}
