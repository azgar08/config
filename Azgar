#!/usr/bin/env python3
"""AWS Glue entry script: Credit Card PII Redaction.

Only job orchestration lives here (arguments, batch metadata, summary, exit code).
The redaction engine is the pci_redaction package, loaded from S3 via the Glue job
parameter:  --extra-py-files s3://<bucket>/libs/pci_redaction.zip
"""
from __future__ import annotations

import argparse
import os
import sys
import uuid
from datetime import datetime, timezone
from typing import Optional
import boto3

from pci_redaction.batch import run_batch
from pci_redaction.config import (
    DEFAULT_MASK_LAST_FOUR,
    DEFAULT_MIN_CONFIDENCE,
    MODEL_MIN_CONFIDENCE,
    logger,
)
from pci_redaction.s3_io import list_s3_images
from pci_redaction.tracking import (
    create_batch_metadata,
    init_dynamodb,
    update_batch_metadata_counts,
    update_batch_metadata_stage,
)
# ---------------------------------------------------------------------------
# Glue Job Main
# ---------------------------------------------------------------------------
def parse_args(argv: Optional[list[str]] = None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Glue Job: Credit Card PII Redaction from images via AWS Textract."
    )
    # S3 parameters
    parser.add_argument("--RAW_BUCKET", required=True, help="S3 bucket containing raw images")
    parser.add_argument("--RAW_PREFIX", default="", help="S3 prefix for raw images")
    parser.add_argument("--GOLDEN_BUCKET", required=True, help="S3 bucket for redacted images")
    parser.add_argument("--GOLDEN_PREFIX", default="redacted/", help="S3 prefix for redacted images")

    # DynamoDB parameters
    parser.add_argument("--IMAGE_TRACKING_TABLE", "--DYNAMODB_TABLE",
                        dest="IMAGE_TRACKING_TABLE", default="dlx-r360plus-redaction-image-metadata-dev",
                        help="DynamoDB table for per-image metadata (default: redact_image_metadata)")
    parser.add_argument("--BATCH_METADATA_TABLE", default="dlx-r360plus-redaction-batch-metadata-dev",
                        help="DynamoDB table for batch-level metadata (default: redact_batch_metadata)")

    parser.add_argument("--TEXTRACT_RATE_CONTROL_TABLE", default="redact-TextractRateControl",
                        help="DynamoDB table for global Textract TPS limiting and metrics; empty disables")
    parser.add_argument("--TEXTRACT_QUOTA_TPS", type=int, default=100,
                        help="Global Textract calls per second allowed (default: 100)")

    # Processing parameters
    parser.add_argument("--REGION", default=None, help="AWS region (defaults to env or us-east-1)")
    parser.add_argument("--MIN_CONFIDENCE", type=float, default=DEFAULT_MIN_CONFIDENCE,
                        help="Minimum confidence to redact; below = review queue")
    parser.add_argument("--MAX_IMAGES", type=int, default=0,
                        help="Max images to process; 0 = all (default: 0)")
    parser.add_argument("--DEBUG_LABELS", default="false",
                        help="Write entity labels on redacted boxes (default: false)")
    parser.add_argument("--ANNOTATE_REDACTIONS", default="false",
                        help="Print type and confidence (Card number, CVV, Expiry) beside each mask (default: false)")
    parser.add_argument(
        "--MASK_LAST_FOUR",
        default=str(DEFAULT_MASK_LAST_FOUR).lower(),
        help="Mask all card digits, including the last four",
    )
    parser.add_argument("--FORCE_REPROCESS", default="false",
                        help="Reprocess even if already tracked in DynamoDB (default: false)")
    parser.add_argument("--VERIFY_REDACTION", default="true",
                        help="Verify redaction mask with OpenCV (default: true)")
    parser.add_argument("--DETECTION_MODE", choices=("rule", "model", "hybrid"), default="rule",
                        help="Detection strategy: rule only, model only, or hybrid (default: rule)")
    parser.add_argument("--MODEL_S3_URI", default="",
                        help="S3 URI of the compressed Transformers model checkpoint")
    parser.add_argument("--MODEL_MIN_CONFIDENCE", type=float, default=MODEL_MIN_CONFIDENCE,
                        help="Minimum accepted model score from 0 to 1")

    # Parallelism
    parser.add_argument("--MAX_CONCURRENCY", type=int, default=32,
                        help="Target Spark task concurrency (default: 32). Keep within the Textract "
                             "DetectDocumentText TPS quota; actual concurrency depends on Glue capacity.")
    parser.add_argument("--SPARK_PARTITIONS", "--PROCESSES", dest="SPARK_PARTITIONS", type=int, default=0,
                        help="Spark partitions; --PROCESSES is retained as a legacy alias")

    # Batch parameters (passed from Lambda/UI)
    parser.add_argument("--BATCH_ID", default="",
                        help="Unique batch identifier (e.g., batch_20261014_1)")
    parser.add_argument("--CURRENT_ASSIGNEE", default="Unassigned",
                        help="Assignee from UI (default: Unassigned)")
    parser.add_argument("--INGESTION_DATE", default="",
                        help="Ingestion date in yyyy-mm-dd format (default: today)")
    parser.add_argument("--INGESTION_TIME", default="",
                        help="Ingestion time from upstream DB")
    parser.add_argument("--FROM_SOURCE_TIME", default="",
                        help="Source time range start from upstream DB")
    parser.add_argument("--TO_SOURCE_TIME", default="",
                        help="Source time range end from upstream DB")
    parser.add_argument("--FROM_ROW_NUMBER", type=int, default=0,
                        help="First upstream row number in this batch")
    parser.add_argument("--TO_ROW_NUMBER", type=int, default=0,
                        help="Last upstream row number in this batch")
    # Glue passes runtime options such as --internal-lib-urls alongside job options.
    args, _ = parser.parse_known_args(argv)
    if args.DETECTION_MODE != "rule" and not args.MODEL_S3_URI.strip():
        parser.error("--MODEL_S3_URI is required when DETECTION_MODE is model or hybrid")
    if not 0 <= args.MODEL_MIN_CONFIDENCE <= 1:
        parser.error("--MODEL_MIN_CONFIDENCE must be between 0 and 1")
    return args


def str_to_bool(value: str) -> bool:
    return str(value).lower() in ("true", "1", "yes", "y", "t")


def main() -> int:
    args = parse_args()

    region = args.REGION or os.environ.get("AWS_REGION") or os.environ.get("AWS_DEFAULT_REGION") or "us-east-1"
    min_confidence = args.MIN_CONFIDENCE
    max_images = args.MAX_IMAGES
    debug_labels = str_to_bool(args.DEBUG_LABELS)
    annotate_redactions = str_to_bool(args.ANNOTATE_REDACTIONS)
    mask_last_four = str_to_bool(args.MASK_LAST_FOUR)
    force_reprocess = str_to_bool(args.FORCE_REPROCESS)
    verify_redaction_flag = str_to_bool(args.VERIFY_REDACTION)
    detection_mode = args.DETECTION_MODE

    # Batch parameters
    batch_id = args.BATCH_ID or f"batch_{datetime.now(timezone.utc).strftime('%Y%m%d_%H%M%S')}"
    current_assignee = args.CURRENT_ASSIGNEE
    ingestion_date = args.INGESTION_DATE or datetime.now(timezone.utc).strftime("%Y-%m-%d")
    ingestion_time = args.INGESTION_TIME
    from_source_time = args.FROM_SOURCE_TIME
    to_source_time = args.TO_SOURCE_TIME

    job_run_id = str(uuid.uuid4())
    run_start = datetime.now(timezone.utc)

    logger.info("=" * 70)
    logger.info("Credit Card PII Redaction Glue Job")
    logger.info("=" * 70)
    logger.info(f"Job Run ID:          {job_run_id}")
    logger.info(f"Batch ID:            {batch_id}")
    logger.info(f"Current Assignee:    {current_assignee}")
    logger.info(f"Ingestion Date:      {ingestion_date}")
    logger.info(f"Ingestion Time:      {ingestion_time}")
    logger.info(f"From Source Time:    {from_source_time}")
    logger.info(f"To Source Time:      {to_source_time}")
    logger.info(f"Raw Bucket:          s3://{args.RAW_BUCKET}/{args.RAW_PREFIX}")
    logger.info(f"Golden Bucket:       s3://{args.GOLDEN_BUCKET}/{args.GOLDEN_PREFIX}")
    logger.info(f"Image Tracking Table:{args.IMAGE_TRACKING_TABLE}")
    logger.info(f"Batch Metadata Table:{args.BATCH_METADATA_TABLE}")
    logger.info(f"Region:              {region}")
    logger.info(f"Min Confidence:      {min_confidence}")
    logger.info(f"Max Images:          {max_images if max_images else 'ALL'}")
    logger.info(f"Debug Labels:        {debug_labels}")
    logger.info(f"Annotate Redactions: {annotate_redactions}")
    logger.info(f"Mask Last Four:      {mask_last_four}")
    logger.info(f"Force Reprocess:     {force_reprocess}")
    logger.info(f"Verify Redaction:    {verify_redaction_flag}")
    logger.info(f"Detection Mode:      {detection_mode}")
    logger.info(
        f"Max Concurrency:     {args.MAX_CONCURRENCY} "
        f"(Spark partitions: {args.SPARK_PARTITIONS or 'auto'})"
    )
    logger.info("=" * 70)

    # Initialize AWS clients (workers create their own clients for image processing)
    session = boto3.session.Session(region_name=region)
    s3_client = session.client("s3")
    if detection_mode != "rule":
        from pci_redaction import model

        model.configure_model(
            args.MODEL_S3_URI,
            None,
            region,
            s3_client,
            args.MODEL_MIN_CONFIDENCE,
        )
    ddb_batch_table = init_dynamodb(args.BATCH_METADATA_TABLE, region)

    # Create batch metadata record with status "Processing"
    create_batch_metadata(
        ddb_batch_table,
        batch_id=batch_id,
        raw_bucket=args.RAW_BUCKET,
        raw_prefix=args.RAW_PREFIX,
        current_assignee=current_assignee,
        ingestion_date=ingestion_date,
        ingestion_time=ingestion_time,
        from_source_time=from_source_time,
        to_source_time=to_source_time,
        from_row_number=args.FROM_ROW_NUMBER,
        to_row_number=args.TO_ROW_NUMBER,
    )

    # List images in raw bucket
    keys = list_s3_images(s3_client, args.RAW_BUCKET, args.RAW_PREFIX, max_images)
    ingestion_complete_time = datetime.now(timezone.utc).isoformat()
    update_batch_metadata_stage(
        ddb_batch_table,
        batch_id,
        "Ingested",
        ingestion_date=ingestion_date,
        ingestionCompleteTime=ingestion_complete_time,
    )
    if not keys:
        logger.error("No supported images found in raw bucket.")
        update_batch_metadata_counts(
            ddb_batch_table, batch_id, ingestion_date=ingestion_date,
            image_count=0, high_conf_redacted_count=0, need_review_count=0,
            error_count=0, no_pci_count=0, review_completed=0,
            status="Error",
        )
        return 1
    logger.info(f"Found {len(keys)} images to process.")
    update_batch_metadata_stage(
        ddb_batch_table,
        batch_id,
        "Processing",
        ingestion_date=ingestion_date,
        processingStartTime=datetime.now(timezone.utc).isoformat(),
    )

    # Spark task slots on the Glue executors determine actual parallelism.
    results = run_batch(
        keys,
        region=region,
        image_table=args.IMAGE_TRACKING_TABLE,
        textract_rate_control=args.TEXTRACT_RATE_CONTROL_TABLE,
        textract_quota_tps=args.TEXTRACT_QUOTA_TPS,
        max_concurrency=args.MAX_CONCURRENCY,
        partitions=args.SPARK_PARTITIONS,
        detection_mode=detection_mode,
        model_s3_uri=args.MODEL_S3_URI,
        model_min_confidence=args.MODEL_MIN_CONFIDENCE,
        job_run_id=job_run_id,
        raw_bucket=args.RAW_BUCKET,
        golden_bucket=args.GOLDEN_BUCKET,
        golden_prefix=args.GOLDEN_PREFIX,
        min_confidence=min_confidence,
        debug_labels=debug_labels,
        annotate_redactions=annotate_redactions,
        mask_last_four=mask_last_four,
        verify_redaction_flag=verify_redaction_flag,
        force_reprocess=force_reprocess,
        batch_id=batch_id,
        current_assignee=current_assignee,
    )

    # Compute batch-level aggregate counts
    run_end = datetime.now(timezone.utc)
    total_seconds = (run_end - run_start).total_seconds()

    total_images = len(results)
    completed = sum(1 for r in results if r.get("status") == "COMPLETED")
    failed = sum(1 for r in results if r.get("status") == "FAILED")
    skipped = sum(1 for r in results if r.get("status", "").startswith("SKIPPED"))
    blank = sum(1 for r in results if r.get("status") == "BLANK_SKIPPED")
    verification_failed = sum(1 for r in results if r.get("status") == "VERIFICATION_FAILED")

    # Aggregate counts for batch metadata:
    # - highConfRedactedCount: successfully auto-redacted images not routed to review
    # - needReviewCount: review entries, review-required buckets, or verification failures
    # - errorCount: images that failed processing
    # - noPCICount: images with no redactions and no outstanding review requirement
    high_conf_redacted_count = 0
    need_review_count = 0
    error_count = failed
    no_pci_count = 0
    review_completed = 0

    for r in results:
        status_val = r.get("status", "")
        review_status = r.get("reviewStatus", "")
        if review_status in {"NeedReview", "Unassigned"}:
            need_review_count += 1
        elif review_status == "AutoRedacted":
            high_conf_redacted_count += 1
        elif review_status == "NoPCI":
            no_pci_count += 1

    completed_uploads = [
        (r["publishingStartTime"], r["publishingEndTime"])
        for r in results
        if r.get("publishingStartTime") and r.get("publishingEndTime")
    ]
    publishing_start_time = min((start for start, _ in completed_uploads), default="")
    publishing_end_time = max((end for _, end in completed_uploads), default="")

    # Determine final batch status
    if error_count == total_images:
        batch_status = "Error"
    elif need_review_count > 0:
        batch_status = "Unassigned"
    else:
        batch_status = "Completed"

    # Update batch metadata with final counts
    update_batch_metadata_counts(
        ddb_batch_table,
        batch_id=batch_id,
        ingestion_date=ingestion_date,
        image_count=total_images,
        high_conf_redacted_count=high_conf_redacted_count,
        need_review_count=need_review_count,
        error_count=error_count,
        no_pci_count=no_pci_count,
        review_completed=review_completed,
        status=batch_status,
        publishing_start_time=publishing_start_time,
        publishing_end_time=publishing_end_time,
        current_assignee="Unassigned" if batch_status == "Unassigned" else None,
    )

    logger.info("=" * 70)
    logger.info("Job Summary")
    logger.info("=" * 70)
    logger.info(f"Batch ID:                {batch_id}")
    logger.info(f"Total images:            {total_images}")
    logger.info(f"High-confidence redacted:{high_conf_redacted_count}")
    logger.info(f"No PCI detected:         {no_pci_count}")
    logger.info(f"Need review:             {need_review_count}")
    logger.info(f"Errors:                  {error_count}")
    logger.info(f"Verification failed:      {verification_failed}")
    logger.info(f"Blank pages skipped:     {blank}")
    logger.info(f"Skipped (already done):   {skipped}")
    logger.info(f"Batch status:            {batch_status}")
    logger.info(f"Total time:              {total_seconds:.2f}s")
    logger.info(f"Average per image:       {total_seconds / max(total_images, 1):.2f}s")
    logger.info(f"Job Run ID:              {job_run_id}")
    logger.info("=" * 70)

    # Return 0 (success) if no hard errors.
    # Verification failures are NOT job failures — they are quality flags
    # that route images to the review queue. The job ran successfully;
    # it just found some images that need human review.
    # Only return 1 (FAILED) if images actually crashed/errored during processing.
    if error_count > 0:
        logger.warning(f"Job completed with {error_count} hard errors — marking as FAILED.")
        return 1
    if verification_failed > 0:
        logger.info(f"Job completed with {verification_failed} verification failures — flagged for review (job status = SUCCESS).")
    return 0


if __name__ == "__main__":
    # Glue Spark jobs treat any SystemExit (even code 0) as FAILED, so only
    # exit explicitly on failure and let the script end normally on success.
    exit_code = main()
    if exit_code:
        sys.exit(exit_code)
