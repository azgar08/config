
#!/usr/bin/env bash
set -euo pipefail

# Clean previous workspace
rm -rf /tmp/infrastructure.raas.terraform.live
rm -rf /tmp/src
rm -rf /tmp/unzipped_archive

# Verify tool versions
export TENV_AUTO_INSTALL=true
export TERRAGRUNT_TFPATH=tofu

echo "TENV_AUTO_INSTALL=$TENV_AUTO_INSTALL"
tofu -v
terragrunt --version

# Assume the Terraform role
case "<+pipeline.variables.env_delegate>" in
  dev-iac-delegate)
    aws_credentials_json=$(aws sts assume-role \
      --role-arn arn:aws:iam::697179190149:role/Terraform-Admin-Role \
      --role-session-name DEVSession)
    ;;
  nonprod-iac-delegate)
    aws_credentials_json=$(aws sts assume-role \
      --role-arn arn:aws:iam::518383396166:role/Terraform-Admin-Role \
      --role-session-name NONPRODSession)
    ;;
  prod-iac-delegate)
    aws_credentials_json=$(aws sts assume-role \
      --role-arn arn:aws:iam::908976231039:role/Terraform-Admin-Role \
      --role-session-name PRODSession)
    ;;
  *)
    echo "ERROR: Unable to assume role for delegate."
    exit 1
    ;;
esac

export AWS_ACCESS_KEY_ID=$(echo "$aws_credentials_json" | jq -er '.Credentials.AccessKeyId')
export AWS_SECRET_ACCESS_KEY=$(echo "$aws_credentials_json" | jq -er '.Credentials.SecretAccessKey')
export AWS_SESSION_TOKEN=$(echo "$aws_credentials_json" | jq -er '.Credentials.SessionToken')

aws sts get-caller-identity

# Print deployment action
echo "***** Deploy action: <+pipeline.variables.deploy_action> on <+pipeline.variables.environment> *****"

# Retrieve packaged source from Artifactory
unzip_path="/tmp/unzipped_archive"
target_src="/tmp/src"

mkdir -p "$unzip_path"
mkdir -p "$target_src/glue"

pushd "$unzip_path"

if [ "<+pipeline.variables.package_version>" = "NA" ]; then
  src_file="<+pipeline.variables.trigger_package>"
else
  src_file="<+pipeline.variables.module_name>-<+pipeline.variables.package_version>.zip"
fi

file_url="<+pipeline.variables.artifactory_url>/<+pipeline.variables.artifactory_repo>/<+pipeline.variables.framework_name>/$src_file"

echo "Downloading Redaction Glue package: $file_url"

wget -O "$src_file" "$file_url"

# Extract Redaction Glue source
echo "Extracting $src_file..."

unzip -o "$src_file" -d "$target_src/glue"

# Validate extracted source
echo "Validating extracted Glue source..."

test -f "$target_src/glue/glue_redaction.py"
test -d "$target_src/glue/pci_redaction"

echo "Extracted source files:"
ls -lah "$target_src/glue"

popd

# Clone IaC source from Bitbucket
cd /tmp

git clone git@bitbucket.org:deluxe-development/infrastructure.raas.terraform.live.git

cd /tmp/infrastructure.raas.terraform.live

git fetch
git checkout "<+pipeline.variables.branch_name>"
git branch

# Move to Redaction Glue Terragrunt folder
cd "/tmp/infrastructure.raas.terraform.live/<+pipeline.variables.aws_lz>/<+pipeline.variables.aws_region>/<+pipeline.variables.environment>/pci-redaction/glues/glue-batch-processor"

# Terragrunt Plan
echo "Running Terragrunt Plan..."

sed -i "s/REPLACE/$src_file/g" terragrunt.hcl

terragrunt plan

echo "Terragrunt Plan completed successfully."

# Clean up
rm -rf /tmp/infrastructure.raas.terraform.live
rm -rf "$unzip_path"
rm -rf "$target_src"

unset AWS_ACCESS_KEY_ID
unset AWS_SECRET_ACCESS_KEY
unset AWS_SESSION_TOKEN
unset TENV_AUTO_INSTALL
unset TERRAGRUNT_TFPATH
