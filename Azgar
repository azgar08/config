### To handle the log subscription at provisioning time, we have to create log group in TF then subscribe to the log forwarder lambda
### Because this stack will run to update on existing infrastructure so it has to support fresh and update deployment
### so we have to check if the log group exists then do nothing or else create new log group
resource "null_resource" "create_log_groups" {
  triggers = {
    invoker   = uuid()
    region    = data.aws_region.current.name
    log_group = var.log_group_name
  }
  provisioner "local-exec" {
    interpreter = ["bash", "-c"]
    command     = <<-EOT
      aws_log=$(aws logs describe-log-groups --log-group-name-prefix ${self.triggers.log_group} --region ${self.triggers.region} --query 'logGroups[*].logGroupName' --output text)
      if [ -z "$aws_log" ]; then
        echo "Create log group"
        aws logs create-log-group --log-group-name ${self.triggers.log_group} --region ${self.triggers.region}
      else
        echo "Log group $aws_log exists"
      fi
    EOT
  }
}

resource "aws_lambda_permission" "allow_cw_log" {
  statement_id  = "AllowTriggerFrom-${local.log_id}"
  action        = "lambda:InvokeFunction"
  function_name = local.lambda_name
  principal     = "logs.amazonaws.com"
  source_arn    = "${local.log_arn}:*"

  depends_on = [null_resource.create_log_groups]
}

resource "aws_cloudwatch_log_subscription_filter" "lambda_log_subscription" {
  name            = "${local.lambda_name}-subscription"
  log_group_name  = var.log_group_name
  filter_pattern  = ""
  destination_arn = var.lambda_arn

  depends_on = [aws_lambda_permission.allow_cw_log]
}
