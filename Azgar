pipeline:
  name: Deploy PCI Redaction Batch Processor Glue
  identifier: Deploy_PCI_Redaction_Batch_Processor_Glue
  projectIdentifier: RaaS
  orgIdentifier: Payments
  tags: {}

  stages:
    - stage:
        name: Deploy PCI Redaction Batch Processor Glue
        identifier: Deploy_PCI_Redaction_Batch_Processor_Glue
        type: Custom
        spec:
          execution:
            steps:
              - step:
                  type: ShellScript
                  name: Terragrunt Plan
                  identifier: Terragrunt_Plan
                  spec:
                    shell: Bash
                    source:
                      type: Inline
                      spec:
                        script: |-
                          set -euo pipefail

                          export TENV_AUTO_INSTALL=true
                          export TERRAGRUNT_TFPATH=tofu

                          echo "Deployment action: <+pipeline.variables.deploy_action>"
                          echo "Environment: <+pipeline.variables.environment>"
                          echo "Region: <+pipeline.variables.aws_region>"

                          case "<+pipeline.variables.env_delegate>" in
                            dev-iac-delegate)
                              ROLE_ARN="arn:aws:iam::697179190149:role/Terraform-Admin-Role"
                              ;;
                            nonprod-iac-delegate)
                              ROLE_ARN="arn:aws:iam::518383396166:role/Terraform-Admin-Role"
                              ;;
                            prod-iac-delegate)
                              ROLE_ARN="arn:aws:iam::908976231039:role/Terraform-Admin-Role"
                              ;;
                            *)
                              echo "Invalid delegate"
                              exit 1
                              ;;
                          esac

                          aws_credentials_json=$(aws sts assume-role \
                            --role-arn "$ROLE_ARN" \
                            --role-session-name RedactionGlueDeploy)

                          export AWS_ACCESS_KEY_ID=$(echo "$aws_credentials_json" | jq -r .Credentials.AccessKeyId)
                          export AWS_SECRET_ACCESS_KEY=$(echo "$aws_credentials_json" | jq -r .Credentials.SecretAccessKey)
                          export AWS_SESSION_TOKEN=$(echo "$aws_credentials_json" | jq -r .Credentials.SessionToken)

                          aws sts get-caller-identity

                          rm -rf /tmp/infrastructure.raas.terraform.live

                          cd /tmp

                          git clone git@bitbucket.org:deluxe-development/infrastructure.raas.terraform.live.git

                          cd infrastructure.raas.terraform.live

                          git checkout "<+pipeline.variables.branch_name>"

                          cd "<+pipeline.variables.aws_lz>/<+pipeline.variables.aws_region>/<+pipeline.variables.environment>/pci-redaction/glues/glue-batch-processor"

                          terragrunt init

                          terragrunt plan

                          rm -rf /tmp/infrastructure.raas.terraform.live

                          unset AWS_ACCESS_KEY_ID
                          unset AWS_SECRET_ACCESS_KEY
                          unset AWS_SESSION_TOKEN
                  timeout: 45m

              - step:
                  type: HarnessApproval
                  name: Apply Approval
                  identifier: Apply_Approval
                  spec:
                    approvalMessage: Please review the PCI Redaction Glue plan and approve.
                    includePipelineExecutionHistory: true
                    isAutoRejectEnabled: false
                    approvers:
                      userGroups:
                        - account.Harness_RaaS_DevOps
                      minimumCount: 1
                      disallowPipelineExecutor: false
                    approverInputs: []
                  timeout: 1h
                  when:
                    stageStatus: Success
                    condition: <+pipeline.variables.deploy_action> == "apply"

              - step:
                  type: ShellScript
                  name: Terragrunt Apply
                  identifier: Terragrunt_Apply
                  spec:
                    shell: Bash
                    source:
                      type: Inline
                      spec:
                        script: |-
                          set -euo pipefail

                          export TENV_AUTO_INSTALL=true
                          export TERRAGRUNT_TFPATH=tofu

                          case "<+pipeline.variables.env_delegate>" in
                            dev-iac-delegate)
                              ROLE_ARN="arn:aws:iam::697179190149:role/Terraform-Admin-Role"
                              ;;
                            nonprod-iac-delegate)
                              ROLE_ARN="arn:aws:iam::518383396166:role/Terraform-Admin-Role"
                              ;;
                            prod-iac-delegate)
                              ROLE_ARN="arn:aws:iam::908976231039:role/Terraform-Admin-Role"
                              ;;
                            *)
                              echo "Invalid delegate"
                              exit 1
                              ;;
                          esac

                          aws_credentials_json=$(aws sts assume-role \
                            --role-arn "$ROLE_ARN" \
                            --role-session-name RedactionGlueApply)

                          export AWS_ACCESS_KEY_ID=$(echo "$aws_credentials_json" | jq -r .Credentials.AccessKeyId)
                          export AWS_SECRET_ACCESS_KEY=$(echo "$aws_credentials_json" | jq -r .Credentials.SecretAccessKey)
                          export AWS_SESSION_TOKEN=$(echo "$aws_credentials_json" | jq -r .Credentials.SessionToken)

                          rm -rf /tmp/infrastructure.raas.terraform.live

                          cd /tmp

                          git clone git@bitbucket.org:deluxe-development/infrastructure.raas.terraform.live.git

                          cd infrastructure.raas.terraform.live

                          git checkout "<+pipeline.variables.branch_name>"

                          cd "<+pipeline.variables.aws_lz>/<+pipeline.variables.aws_region>/<+pipeline.variables.environment>/pci-redaction/glues/glue-batch-processor"

                          terragrunt init

                          terragrunt apply --auto-approve

                          rm -rf /tmp/infrastructure.raas.terraform.live

                          unset AWS_ACCESS_KEY_ID
                          unset AWS_SECRET_ACCESS_KEY
                          unset AWS_SESSION_TOKEN
                  timeout: 45m
                  when:
                    stageStatus: Success
                    condition: <+pipeline.variables.deploy_action> == "apply"

  variables:
    - name: branch_name
      type: String
      required: true
      value: <+input>.default(dev-east-1)

    - name: aws_lz
      type: String
      required: true
      value: <+input>.default(DEV).selectOneFrom(DEV,NONPROD,PROD)

    - name: aws_region
      type: String
      required: true
      value: <+input>.default(us-east-1).selectOneFrom(us-east-1,us-west-2)

    - name: environment
      type: String
      required: true
      value: <+input>.default(DEV).selectOneFrom(DEV,QA,RC,XUAT,PROD,DR)

    - name: deploy_action
      type: String
      required: true
      value: <+input>.default(apply).selectOneFrom(plan,apply,destroy)

    - name: env_delegate
      type: String
      required: true
      value: <+input>.default(dev-iac-delegate).selectOneFrom(dev-iac-delegate,nonprod-iac-delegate,prod-iac-delegate)

  delegateSelectors:
    - <+pipeline.variables.env_delegate>
