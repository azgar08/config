default_cache_behavior {
  target_origin_id = "offline-s3"

  viewer_protocol_policy = "redirect-to-https"

  allowed_methods = [
    "GET",
    "HEAD"
  ]

  cached_methods = [
    "GET",
    "HEAD"
  ]

  forwarded_values {
    query_string = false

    cookies {
      forward = "none"
    }
  }

  min_ttl     = 0
  default_ttl = 300
  max_ttl     = 3600

  compress = true
}
