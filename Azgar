# DynamoDB Table Resource Policy

output "dynamodb_table_policy_id" {
  description = "DynamoDB table resource policy ID"
  value       = try(aws_dynamodb_resource_policy.table_policy[0].id, null)
}

output "dynamodb_table_policy" {
  description = "DynamoDB table resource policy JSON"
  value       = try(data.aws_iam_policy_document.table_policy[0].json, null)
}

