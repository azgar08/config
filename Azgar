#!/usr/bin/env bash
set -euo pipefail

export DEBIAN_FRONTEND=noninteractive

# Package version
export package_version="PCI-project-flow.0.2.12"

MODULE_DIR="glue/batch-ingestion"
PACKAGE_DIR="$(mktemp -d)"
export packaged_file="batch-ingestion-${package_version}.zip"

trap 'rm -rf "$PACKAGE_DIR" verify_zip' EXIT

echo "============================================================"
echo "Starting Batch Ingestion Glue Packaging"
echo "Package Version: ${package_version}"
echo "============================================================"

# ============================================================
# Install Build Utilities
# ============================================================

echo "Installing build utilities..."

apt-get update -qq

apt-get install -y -qq \
  zip \
  unzip \
  python3-pip

apt-get clean
rm -rf /var/lib/apt/lists/*

# ============================================================
# Validate Source
# ============================================================

echo "Validating source files..."

test -f "$MODULE_DIR/src/spark_job.py"
test -d "$MODULE_DIR/src/ingestion"
test -d "$MODULE_DIR/src/ingestion/dataguard"

python --version
python -m pip --version

# ============================================================
# Copy Glue Script
# ============================================================

echo "Copying Glue script..."

cp "$MODULE_DIR/src/spark_job.py" "$PACKAGE_DIR/"

# ============================================================
# Prepare Library Directory
# ============================================================

mkdir -p "$PACKAGE_DIR/library"

# ============================================================
# Build the component wheel and its Linux dependencies
# ============================================================

echo "Building the ingestion wheelhouse from setup.py..."

python -m pip wheel \
  --no-cache-dir \
  --wheel-dir "$PACKAGE_DIR/wheels" \
  "$MODULE_DIR"

mkdir -p "$PACKAGE_DIR/verify"
python -m pip install \
  --no-cache-dir \
  --no-index \
  --find-links "$PACKAGE_DIR/wheels" \
  --target "$PACKAGE_DIR/verify" \
  raas-batch-ingestion==0.1.0

PYTHONPATH="$PACKAGE_DIR/verify" python -c '
import jsonschema
import pg8000
import referencing
import rpds.rpds
from importlib.resources import files
from ingestion.dataguard.validation import validate_payload

assert files("ingestion.schemas").joinpath("common.schema.json").is_file()
print("jsonschema:", jsonschema.__version__)
print("referencing:", referencing.__version__ if hasattr(referencing, "__version__") else "available")
print("rpds native extension: available")
print("ingestion package and schema resources: available")
'

# ============================================================
# Create source-only ingestion.zip
# ============================================================

echo "Copying ingestion source..."

mkdir -p "$PACKAGE_DIR/library"
cp -R "$MODULE_DIR/src/ingestion" "$PACKAGE_DIR/library/"

# ============================================================
# Create ingestion.zip
# ============================================================

echo "Creating ingestion.zip..."

(
  cd "$PACKAGE_DIR/library"

  zip -1 -q -r "$PACKAGE_DIR/ingestion.zip" . \
    -x "*/__pycache__/*" \
       "*.pyc" \
       "*.pyo"
)

# ============================================================
# Validate ingestion.zip
# ============================================================

echo "Validating ingestion.zip..."

unzip -t "$PACKAGE_DIR/ingestion.zip" >/dev/null

# Confirm ingestion source is present
unzip -l "$PACKAGE_DIR/ingestion.zip" |
  grep -q "ingestion/dataguard/validation.py"

# Compiled dependencies must be installed from wheels, not ZIP imports.
if unzip -l "$PACKAGE_DIR/ingestion.zip" |
   grep -Eq '(^|[[:space:]])(jsonschema/|referencing/|rpds/)'; then
  echo "ERROR: runtime dependencies were found in source-only ingestion.zip"
  exit 1
fi

echo "ingestion.zip validation: SUCCESS"

# ============================================================
# Create Deployment Package
# ============================================================

echo "Creating deployment package..."

mkdir -p "$PACKAGE_DIR/deploy"

cp "$PACKAGE_DIR/spark_job.py" "$PACKAGE_DIR/deploy/"
cp "$PACKAGE_DIR/ingestion.zip" "$PACKAGE_DIR/deploy/"
cp -R "$PACKAGE_DIR/wheels" "$PACKAGE_DIR/deploy/"

(
  cd "$PACKAGE_DIR/deploy"

  zip -1 -q -r "$OLDPWD/$packaged_file" .
)

# ============================================================
# Validate Deployment Package
# ============================================================

echo "Validating deployment package..."

unzip -t "$packaged_file" >/dev/null

test -s "$packaged_file"

# ============================================================
# Final Package Listing
# ============================================================

echo ""
echo "============================================================"
echo "DEPLOYMENT PACKAGE CONTENTS"
echo "============================================================"

unzip -l "$packaged_file"

# ============================================================
# Inspect ingestion.zip Inside Deployment Package
# ============================================================

echo ""
echo "============================================================"
echo "LIBRARY PACKAGE CONTENTS"
echo "============================================================"

mkdir -p verify_zip

unzip -q "$packaged_file" -d verify_zip

unzip -l verify_zip/ingestion.zip

# ============================================================
# Package Size
# ============================================================

echo ""
echo "============================================================"
echo "PACKAGE SIZE"
echo "============================================================"

ls -lh "$packaged_file"

# ============================================================
# Harness Output Variables
# ============================================================

echo "packaged_file $packaged_file" >> /addon/tmp/ArchiveSource.out
echo "package_version $package_version" >> /addon/tmp/ArchiveSource.out

# ============================================================
# Completion
# ============================================================

echo ""
echo "============================================================"
echo "Batch Ingestion Glue Package Build Completed Successfully"
echo "Package: ${packaged_file}"
echo "Version: ${package_version}"
echo "============================================================"
echo "packaged_file $packaged_file" >> /addon/tmp/ArchiveSource.out
echo "package_version $package_version" >> /addon/tmp/ArchiveSource.out
