<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>404 - Endpoint Offline</title>

    <style>

        * {
            box-sizing: border-box;
        }

        body {

            margin: 0;

            min-height: 100vh;

            display: flex;

            align-items: center;

            justify-content: center;

            font-family:
                Arial,
                Helvetica,
                sans-serif;

            background: #f5f6f8;

            color: #252a30;
        }

        .container {

            width: 90%;

            max-width: 600px;

            text-align: center;

            background: #ffffff;

            padding: 55px 40px;

            border-radius: 12px;

            box-shadow:
                0 5px 25px rgba(0, 0, 0, 0.08);
        }

        .error {

            font-size: 86px;

            font-weight: 700;

            margin: 0;

            letter-spacing: 2px;
        }

        h2 {

            margin: 10px 0 20px;

            font-size: 30px;
        }

        p {

            margin: 10px 0;

            font-size: 17px;

            line-height: 1.6;

            color: #666;
        }

        .message {

            margin-top: 25px;
        }

        .footer {

            margin-top: 30px;

            font-size: 13px;

            color: #999;
        }

    </style>

</head>

<body>

    <div class="container">

        <div class="error">
            404
        </div>

        <h2>
            Endpoint Offline
        </h2>

        <div class="message">

            <p>
                The requested endpoint is currently unavailable
                because the DR endpoint is offline.
            </p>

            <p>
                Please try again later.
            </p>

        </div>

        <div class="footer">
            DR Environment
        </div>

    </div>

</body>

</html>
