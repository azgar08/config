
### Create the log group if it does not exist
resource "null_resource" "create_log_groups" {
  triggers = {
    invoker   = uuid()
    region    = data.aws_region.current.name
    log_group = var.log_group_name
  }

  provisioner "local-exec" {
    interpreter = ["bash", "-c"]

    command = <<-EOT
      aws_log=$(aws logs describe-log-groups \
        --log-group-name-prefix '${self.triggers.log_group}' \
        --region '${self.triggers.region}' \
        --query 'logGroups[*].logGroupName' \
        --output text)

      if [ -z "$aws_log" ]; then
        echo "Creating log group ${self.triggers.log_group}"
        aws logs create-log-group \
          --log-group-name '${self.triggers.log_group}' \
          --region '${self.triggers.region}'
      else
        echo "Log group exists: $aws_log"
      fi
    EOT
  }
}

locals {
  # Derive the function name from the Lambda ARN.
  # Expected ARN format:
  # arn:aws:lambda:region:account-id:function:function-name
  lambda_name = element(split(":", var.lambda_arn), 6)
}

resource "aws_lambda_permission" "allow_cw_log" {
  statement_id   = "AllowTriggerFrom-${local.log_id}"
  action         = "lambda:InvokeFunction"
  function_name  = local.lambda_name
  principal      = "logs.amazonaws.com"
  source_arn     = "${local.log_arn}:*"

  depends_on = [null_resource.create_log_groups]
}

resource "aws_cloudwatch_log_subscription_filter" "lambda_log_subscription" {
  name            = "${local.lambda_name}-subscription"
  log_group_name  = var.log_group_name
  filter_pattern  = ""
  destination_arn = var.lambda_arn

  depends_on = [aws_lambda_permission.allow_cw_log]
}
