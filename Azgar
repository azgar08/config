
#!/usr/bin/env bash
set -euo pipefail

export DEBIAN_FRONTEND=noninteractive

# ============================================================
# Configuration
# ============================================================

MODULE_DIR="glue/batch-ingestion"
PACKAGE_VERSION="PCI-project-flow.0.2.12"
PACKAGED_FILE="batch-ingestion-${PACKAGE_VERSION}.zip"

WORK_DIR="$(mktemp -d)"
OUTPUT_DIR="$PWD"

LIBRARY_DIR="$WORK_DIR/library"
VERIFY_DIR="$WORK_DIR/verify"
WHEEL_DIR="$WORK_DIR/wheels"
DEPLOY_DIR="$WORK_DIR/deploy"

trap 'rm -rf "$WORK_DIR"' EXIT

echo "============================================================"
echo "Starting Batch Ingestion Glue Packaging"
echo "Package Version: ${PACKAGE_VERSION}"
echo "============================================================"

# ============================================================
# Install Build Utilities
# ============================================================

apt-get update -qq

apt-get install -y -qq \
  zip \
  unzip \
  python3-pip

apt-get clean
rm -rf /var/lib/apt/lists/*

python --version
python -m pip --version

# ============================================================
# Validate Source
# ============================================================

echo "Validating source files..."

test -f "$MODULE_DIR/setup.py"
test -f "$MODULE_DIR/requirements.txt"
test -f "$MODULE_DIR/src/spark_job.py"
test -d "$MODULE_DIR/src/ingestion"
test -d "$MODULE_DIR/src/ingestion/dataguard"
test -d "$MODULE_DIR/src/ingestion/schemas"

# ============================================================
# Prepare Directories
# ============================================================

mkdir -p \
  "$LIBRARY_DIR" \
  "$VERIFY_DIR" \
  "$WHEEL_DIR" \
  "$DEPLOY_DIR"

# ============================================================
# Build Package and Dependencies Using setup.py
# ============================================================

echo "Building package and dependency wheels..."

python -m pip wheel \
  --no-cache-dir \
  --wheel-dir "$WHEEL_DIR" \
  "$MODULE_DIR"

# ============================================================
# Install into Verification Directory
# ============================================================

echo "Installing package into verification directory..."

python -m pip install \
  --no-cache-dir \
  --no-index \
  --find-links "$WHEEL_DIR" \
  --target "$VERIFY_DIR" \
  raas-batch-ingestion==0.1.0

# ============================================================
# Validate Dependencies and Application
# ============================================================

echo "Validating Python imports..."

PYTHONPATH="$VERIFY_DIR" python - <<'PY'
import jsonschema
import pg8000
import referencing
import rpds.rpds

from importlib.resources import files
from jsonschema import Draft202012Validator
from ingestion.dataguard.validation import validate_payload

schema = files("ingestion.schemas").joinpath("common.schema.json")

assert schema.is_file(), "Schema resource is missing"

print("jsonschema:", jsonschema.__version__)
print("pg8000:", pg8000.__version__)
print("referencing: available")
print("rpds native extension: available")
print("Draft202012Validator: available")
print("Ingestion application: available")
print("Schema resources: available")

print("Dependency validation: SUCCESS")
PY

# ============================================================
# Create Source-Only ingestion.zip
# ============================================================

echo "Creating source-only ingestion.zip..."

cp -R "$MODULE_DIR/src/ingestion" "$LIBRARY_DIR/"

(
  cd "$LIBRARY_DIR"

  zip -1 -q -r "$WORK_DIR/ingestion.zip" . \
    -x "*/__pycache__/*" \
       "*.pyc" \
       "*.pyo"
)

# ============================================================
# Validate ingestion.zip
# ============================================================

echo "Validating ingestion.zip..."

unzip -t "$WORK_DIR/ingestion.zip" >/dev/null

unzip -l "$WORK_DIR/ingestion.zip" |
  grep -q "ingestion/dataguard/validation.py"

if unzip -l "$WORK_DIR/ingestion.zip" |
   grep -Eq '(^|[[:space:]])(jsonschema/|referencing/|rpds/)'; then
  echo "ERROR: Dependencies found inside source-only ingestion.zip"
  exit 1
fi

echo "ingestion.zip validation: SUCCESS"

# ============================================================
# Prepare Deployment Package
# ============================================================

echo "Preparing deployment package..."

cp "$MODULE_DIR/src/spark_job.py" "$DEPLOY_DIR/"
cp "$WORK_DIR/ingestion.zip" "$DEPLOY_DIR/"

(
  cd "$DEPLOY_DIR"

  zip -1 -q -r "$OUTPUT_DIR/$PACKAGED_FILE" .
)

# ============================================================
# Validate Deployment Package
# ============================================================

echo "Validating deployment package..."

unzip -t "$OUTPUT_DIR/$PACKAGED_FILE" >/dev/null

test -s "$OUTPUT_DIR/$PACKAGED_FILE"

# ============================================================
# Package Contents
# ============================================================

echo "============================================================"
echo "DEPLOYMENT PACKAGE CONTENTS"
echo "============================================================"

unzip -l "$OUTPUT_DIR/$PACKAGED_FILE"

echo "============================================================"
echo "PACKAGE SIZE"
echo "============================================================"

ls -lh "$OUTPUT_DIR/$PACKAGED_FILE"

# ============================================================
# Harness Output Variables
# ============================================================

mkdir -p /addon/tmp

echo "packaged_file $PACKAGED_FILE" >> /addon/tmp/ArchiveSource.out
echo "package_version $PACKAGE_VERSION" >> /addon/tmp/ArchiveSource.out

# ============================================================
# Completion
# ============================================================

echo "============================================================"
echo "Batch Ingestion Glue Package Build Completed Successfully"
echo "Package: $PACKAGED_FILE"
echo "Version: $PACKAGE_VERSION"
echo "============================================================"





--additional-python-modules
jsonschema[format]==4.25.1,pg8000==1.31.6,referencing==0.36.2
