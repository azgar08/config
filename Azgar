output "dynamodb_table_name" {
  description = "Configured DynamoDB table name"
  value       = var.name
}

output "dynamodb_primary_region" {
  description = "Primary DynamoDB region"
  value       = var.region
}

output "dynamodb_multi_region_enabled" {
  description = "Whether multi-region replication is enabled"
  value       = var.enable_multi_region
}

output "dynamodb_replica_regions" {
  description = "Configured replica regions"
  value       = var.enable_multi_region ? var.replica_regions : []
}
