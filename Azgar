locals {
  account_vars    = read_terragrunt_config(find_in_parent_folders("account.hcl"))
  account_number  = local.account_vars.locals.aws_account_id
  region_vars     = read_terragrunt_config(find_in_parent_folders("region.hcl"))
  region          = local.region_vars.locals.aws_region
  environment_var = read_terragrunt_config(find_in_parent_folders("env.hcl"))
  environment     = lower(local.environment_var.locals.environment)
  db_environment  = lower(local.environment_var.locals.db_environment)
  backend_url     = local.environment_var.locals.backend_url
  name            = "dlx-raas-archive-filegenerator-lambda-${local.environment}"
  is_rc_dr        = local.environment == "dr" && local.db_environment == "rc"
  dt_layer_arn    = local.environment_var.locals.dt_layer_arn
  dt_log_endpoint = "https://esn28329.live.dynatrace.com/api/v2/logs/ingest"

  source_base_url = "git::ssh://git@bitbucket.org/deluxe-development/infrastructure.raas.terraform.stacks.git//lambda"

}

dependency "vpc-info" {
  config_path = find_in_parent_folders("_global/vpc-info")
}

dependency "lambda-subnets" {
  config_path = find_in_parent_folders("_global/lambda-glue-subnets")
}

dependency "common-tags" {
  config_path = find_in_parent_folders("common-tags")
}

dependency "kms-monitoring-service-sqs" {
  config_path = find_in_parent_folders("kms-monitoring-service-sqs")
  skip_outputs = local.is_rc_dr

  mock_outputs = {
    kms_arn = ""
  }
}

dependency "sqs-monitoring-service" {
  config_path = find_in_parent_folders("sqs-monitoring-service")
}

dependency "sqs-archive-filegenerator" {
  config_path = find_in_parent_folders("sqs-archive-filegenerator")
}

dependency "sqs-archive-service" {
  config_path = find_in_parent_folders("sqs-archive-service")
}

dependency "datalake" {
  config_path = find_in_parent_folders("datalake")
}

dependency "secret-dynatrace" {
  config_path = find_in_parent_folders("secrets/secret-dynatrace-auth-token")
}

inputs = {
  #GLOBAL VARS
  name       = "${local.name}"
  account_id = "${local.account_number}"
  tags = merge(dependency.common-tags.outputs.common_tags, {
    "TerraformPath" = path_relative_to_include()
  })

  #IAM VARS
  policy_statement = templatefile("policy/statement.tftpl", {
    sqs_archive_filegenerator_kms_arn   = dependency.sqs-archive-filegenerator.outputs.kms_arn,
    sqs_archive_filegenerator_sqs_queue = dependency.sqs-archive-filegenerator.outputs.queue_arn,
    monitoring_queue_kms_arn            = local.is_rc_dr ? dependency.sqs-monitoring-service.outputs.kms_arn : dependency.kms-monitoring-service-sqs.outputs.kms_arn,
    monitoring_queue_sqs_queue          = dependency.sqs-monitoring-service.outputs.queue_arn,
    reports_kms_arn                     = dependency.datalake.outputs.encyption_kms_arn,
    reports_s3_arn                      = dependency.datalake.outputs.reports_s3_arn,
    sqs_archive_service_kms_arn         = dependency.sqs-archive-service.outputs.kms_arn,
    sqs_archive_service_arn             = dependency.sqs-archive-service.outputs.queue_arn,
    dt_secret_arn                       = dependency.secret-dynatrace.outputs.secret_arn,
    dt_secret_kms_arn                   = dependency.secret-dynatrace.outputs.kms_arn
  })
  trusted_entities = [
    "lambda.amazonaws.com"
  ]

  #LAMBDA VARS
  vpc_subnet_ids = dependency.lambda-subnets.outputs.lambda_subnet_ids
  vpc_security_group_ids = [
    dependency.vpc-info.outputs.baseline_sg_id
  ]
  lambda_handler     = "ArchiveFileGenerator::ArchiveFileGenerator.Infrastructure.LambdaFunction::Handler"
  lambda_kms         = dependency.sqs-archive-filegenerator.outputs.kms_arn
  lambda_runtime     = "dotnet10"
  lambda_memory_size = 1024
  lambda_layers = [local.dt_layer_arn]
  lambda_environment_variables = {
    ARCHIVE_QUEUE_URL                                = dependency.sqs-archive-service.outputs.queue_url
    AWSREGION                                        = "${local.region}"
    S3BUCKET                                         = dependency.datalake.outputs.reports_s3_id
    DT_LOG_COLLECTION_AUTH_TOKEN_SECRETS_MANAGER_ARN = dependency.secret-dynatrace.outputs.secret_arn
    DT_LOG_COLLECTION_ENDPOINT                       = local.dt_log_endpoint
  }

  #LAMBDA TRIGGER VARS
  TypeofTrigger  = "sqsTrigger"
  statement_id   = "AllowExecutionFromSQSQueue"
  principal      = "sqs.amazonaws.com"
  lambda_trigger = dependency.sqs-archive-filegenerator.outputs.queue_arn
  event_source_mapping = [{
    event_source_arn = dependency.sqs-archive-filegenerator.outputs.queue_arn
    batch_size       = 1
  }]
}
