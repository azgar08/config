
locals {
  glue_script_location = "s3://${var.s3_glue_bucket}/${var.glue_script_key}"

  glue_extra_py_files = length(var.glue_extra_libs) > 0 ? {
    "--extra-py-files" = join(",", var.glue_extra_libs)
  } : {}

  glue_driver_environment = length(var.glue_driver_env_vars) > 0 ? {
    "--customer-driver-env-vars" = join(
      ",",
      [
        for key, value in var.glue_driver_env_vars :
        "${key}=${value}"
      ]
    )
  } : {}

  standard_glue_arguments = {
    "--job-language"                    = "python"
    "--enable-metrics"                  = "true"
    "--enable-continuous-cloudwatch-log" = "true"
    "--enable-glue-datacatalog"         = "true"
    "--TempDir"                         = "s3://${var.s3_glue_bucket}/temp/"
  }

  default_glue_arguments = merge(
    local.standard_glue_arguments,
    local.glue_extra_py_files,
    local.glue_driver_environment,
    var.default_arguments
  )
}
