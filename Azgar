
#!/usr/bin/env bash
set -euo pipefail

export DEBIAN_FRONTEND=noninteractive

# Package version
export package_version="<+<+codebase.branch>.replaceAll("/","-")>.<+pipeline.variables.packageVersion>.<+pipeline.sequenceId>"

MODULE_DIR="glue/batch-processor"
PACKAGE_DIR="$(mktemp -d)"
export packaged_file="batch-processor-${package_version}.zip"

trap 'rm -rf "$PACKAGE_DIR"' EXIT

echo "Installing ZIP utilities..."
apt-get update -qq
apt-get install -y -qq zip unzip
apt-get clean
rm -rf /var/lib/apt/lists/*

echo "Validating source..."
test -f "$MODULE_DIR/src/glue_redaction.py"
test -d "$MODULE_DIR/src/pci_redaction"
test -f "$MODULE_DIR/requirements.txt"

python --version

echo "Preparing CPU-only requirements..."
grep -vE '^[[:space:]]*torch([=<>!~[:space:]]|$)' \
  "$MODULE_DIR/requirements.txt" > "$PACKAGE_DIR/requirements.txt"

echo "torch==2.5.1+cpu" >> "$PACKAGE_DIR/requirements.txt"

echo "Installing dependencies..."
python -m pip install --no-cache-dir \
  --target "$PACKAGE_DIR" \
  --index-url https://download.pytorch.org/whl/cpu \
  --extra-index-url https://pypi.org/simple \
  -r "$PACKAGE_DIR/requirements.txt"

echo "Validating dependencies..."
PYTHONPATH="$PACKAGE_DIR" python -c \
  "import torch, transformers; print('Torch:', torch.__version__); print('Transformers:', transformers.__version__); assert '+cpu' in torch.__version__"

echo "Copying Glue source..."
cp "$MODULE_DIR/src/glue_redaction.py" "$PACKAGE_DIR/"
cp -R "$MODULE_DIR/src/pci_redaction" "$PACKAGE_DIR/"

echo "Creating ZIP..."
(
  cd "$PACKAGE_DIR"
  zip -1 -q -r "$OLDPWD/$packaged_file" . \
    -x "*/__pycache__/*" "*.pyc" "*.pyo" "requirements.txt"
)

echo "Validating ZIP..."
unzip -t "$packaged_file" >/dev/null
test -s "$packaged_file"

ls -lh "$packaged_file"

echo "packaged_file $packaged_file" >> /addon/tmp/ArchiveSource.out
echo "package_version $package_version" >> /addon/tmp/ArchiveSource.out

echo "Build package completed successfully."
