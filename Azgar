                              cd /tmp/unzipped_archive

                              if [ "<+pipeline.variables.package_version>" = "NA" ]; then
                                src_file="<+pipeline.variables.trigger_package>"
                              else
                                src_file="<+pipeline.variables.module_name>-<+pipeline.variables.package_version>.zip"
                              fi

                              file_url="<+pipeline.variables.artifactory_url>/<+pipeline.variables.artifactory_repo>/<+pipeline.variables.framework_name>/$src_file"

