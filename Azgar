
variable "aws_region" {
  description = "AWS region"
  type        = string
}

variable "environment" {
  description = "Deployment environment"
  type        = string
}

variable "project_name" {
  description = "Project name"
  type        = string
}

variable "account_name" {
  description = "AWS account name"
  type        = string
}

variable "glue_job_name" {
  description = "AWS Glue job name"
  type        = string
}

variable "glue_job_role_arn" {
  description = "IAM role ARN used by the Glue job"
  type        = string
}

variable "s3_glue_bucket" {
  description = "S3 bucket used for Glue scripts and libraries"
  type        = string
}

variable "glue_artifacts" {
  description = "Packaged local files to upload to S3"

  type = list(object({
    name        = string
    type        = string
    source_path = string
    s3_key      = string
  }))

  default = []

  validation {
    condition = alltrue([
      for artifact in var.glue_artifacts :
      contains(["script", "library"], artifact.type)
    ])

    error_message = "Artifact type must be script or library."
  }

  validation {
    condition = (
      length(distinct([
        for artifact in var.glue_artifacts : artifact.name
      ])) == length(var.glue_artifacts)
    )

    error_message = "Every artifact must have a unique name."
  }

  validation {
    condition = (
      length(distinct([
        for artifact in var.glue_artifacts : artifact.s3_key
      ])) == length(var.glue_artifacts)
    )

    error_message = "Every artifact must have a unique S3 key."
  }

  validation {
    condition = alltrue([
      for artifact in var.glue_artifacts :
      length(trimspace(artifact.name)) > 0 &&
      length(trimspace(artifact.source_path)) > 0 &&
      length(trimspace(artifact.s3_key)) > 0
    ])

    error_message = "Artifact name, source path and S3 key cannot be empty."
  }
}

variable "glue_script_artifact_name" {
  description = "Name of the entry script artifact"
  type        = string
}

variable "glue_library_artifact_names" {
  description = "Names of Python library artifacts"
  type        = list(string)
  default     = []
}

variable "glue_extra_libs" {
  description = "Additional external S3 Python library paths"
  type        = list(string)
  default     = []
}

variable "glue_version" {
  description = "AWS Glue version"
  type        = string
  default     = "5.0"
}

variable "python_version" {
  description = "Glue Python version"
  type        = string
  default     = "3"
}

variable "glue_job_execution_class" {
  description = "Glue execution class"
  type        = string
  default     = "STANDARD"
}

variable "worker_type" {
  description = "Glue worker type"
  type        = string
  default     = "G.1X"
}

variable "number_of_workers" {
  description = "Number of Glue workers"
  type        = number
  default     = 2
}

variable "glue_job_max_concur" {
  description = "Maximum concurrent Glue job runs"
  type        = number
  default     = 1
}

variable "timeout" {
  description = "Glue job timeout in minutes"
  type        = number
  default     = 60
}

variable "max_retries" {
  description = "Maximum Glue job retries"
  type        = number
  default     = 0
}

variable "glue_security_cfg" {
  description = "Glue security configuration name"
  type        = string
  default     = ""
}

variable "glue_job_connection" {
  description = "Glue connections"
  type        = list(string)
  default     = []
}

variable "default_arguments" {
  description = "Default arguments passed to the Glue job"
  type        = map(string)
  default     = {}
}

variable "tags" {
  description = "Resource tags"
  type        = map(string)
  default     = {}
}
