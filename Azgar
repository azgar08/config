
set -euo pipefail

apt-get update
apt-get install -y zip rsync unzip
apt-get clean
rm -rf /var/lib/apt/lists/*

# Generate package version
export package_version=<+<+codebase.branch>.replaceAll("/","-")>.<+pipeline.variables.packageVersion>.<+pipeline.sequenceId>

echo "Package version: ${package_version}"

# Update Lambda version
find lambda/<+pipeline.variables.moduleName>/src \
  -name '*.py' \
  -exec sed -i "/VERSION_NUMBER=/c\VERSION_NUMBER=\"${package_version}\"" {} \;

# Define package
export packaged_file="<+pipeline.variables.moduleName>-${package_version}.zip"

REPO_ROOT="$(git rev-parse --show-toplevel)"
SRC_DIR="${REPO_ROOT}/lambda/<+pipeline.variables.moduleName>/src"

cd "${SRC_DIR}"

# Copy internal libraries
if [ -d "../tests/libs" ]; then
  echo "Copying internal libraries..."
  rsync -r --exclude='__pycache__/' --exclude='*.pyc' ../tests/libs/ ./
fi

# Install Python dependencies
if [ -f requirements.txt ]; then
  echo "Installing Python dependencies..."
  python -m pip install \
    --no-cache-dir \
    --no-compile \
    -r requirements.txt \
    --target .
else
  echo "ERROR: requirements.txt not found!"
  exit 1
fi

# Remove unnecessary Python cache files
find . -type d -name '__pycache__' -prune -exec rm -rf {} +
find . -type f -name '*.pyc' -delete

# Create deployment ZIP
echo "Creating Lambda deployment package..."
rm -f "${REPO_ROOT}/${packaged_file}"

zip -r -q "${REPO_ROOT}/${packaged_file}" . \
  -x '*__pycache__*' '*.pyc'

# Validate ZIP
unzip -t "${REPO_ROOT}/${packaged_file}"

echo "Package created successfully:"
ls -lh "${REPO_ROOT}/${packaged_file}"

# Export Harness output
echo "Packaged file: ${packaged_file}"
