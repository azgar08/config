locals {
  glue_script_location = "s3://${var.s3_glue_bucket}/${var.glue_script_key}"

  glue_driver_env_vars = length(var.glue_driver_env_vars) > 0 ? {
    "--customer-driver-env-vars" = join(",", [
      for key in sort(keys(var.glue_driver_env_vars)) :
      "${key}=${var.glue_driver_env_vars[key]}"
    ])
  } : {}

  glue_temp_args = {
    "--TempDir" = "s3://${var.s3_glue_bucket}/temp/"
  }

  glue_extra_lib_args = length(var.glue_extra_libs) > 0 ? {
    "--extra-py-files" = join(",", var.glue_extra_libs)
  } : {}

  default_glue_arguments = merge(
    {
      "--job-language"                     = "python"
      "--enable-metrics"                   = "true"
      "--enable-continuous-cloudwatch-log"  = "true"
      "--enable-glue-datacatalog"           = "true"
    },
    local.glue_temp_args,
    local.glue_extra_lib_args,
    local.glue_driver_env_vars,
    var.default_arguments
  )

  common_tags = merge(var.tags, {
    Environment = var.environment
    Project     = var.project_name
    ManagedBy   = "Terraform"
  })
}
