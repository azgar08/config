
pipeline:
  name: Deploy Redaction Batch Ingestion Glue
  identifier: Deploy_Redaction_Batch_Ingestion_Glue
  projectIdentifier: RaaS
  orgIdentifier: Payments
  tags: {}

  stages:
    - parallel:
        # ==========================================
        # LOWER ENVIRONMENTS - DEV / NONPROD
        # ==========================================
        - stage:
            name: Deploy Redaction Batch Ingestion Glue-Lower
            identifier: Deploy_Redaction_Batch_Ingestion_Glue_Lower
            type: Custom
            spec:
              execution:
                steps:
                  # ------------------------------
                  # PLAN
                  # ------------------------------
                  - step:
                      type: ShellScript
                      name: Redaction Glue Terragrunt Plan
                      identifier: Redaction_Glue_Terragrunt_Plan
                      spec:
                        shell: Bash
                        executionTarget: {}
                        source:
                          type: Inline
                          spec:
                            script: |-
                              set -euo pipefail

                              export TENV_AUTO_INSTALL=true
                              export TERRAGRUNT_TFPATH=tofu

                              tofu -v

                              case "<+pipeline.variables.env_delegate>" in
                                dev-iac-delegate)
                                  ROLE_ARN="arn:aws:iam::697179190149:role/Terraform-Admin-Role"
                                  ;;
                                nonprod-iac-delegate)
                                  ROLE_ARN="arn:aws:iam::518383396166:role/Terraform-Admin-Role"
                                  ;;
                                prod-iac-delegate)
                                  ROLE_ARN="arn:aws:iam::908976231039:role/Terraform-Admin-Role"
                                  ;;
                                *)
                                  echo "Invalid delegate"
                                  exit 1
                                  ;;
                              esac

                              CREDS=$(aws sts assume-role \
                                --role-arn "$ROLE_ARN" \
                                --role-session-name RedactionGluePlan)

                              export AWS_ACCESS_KEY_ID=$(echo "$CREDS" | jq -r '.Credentials.AccessKeyId')
                              export AWS_SECRET_ACCESS_KEY=$(echo "$CREDS" | jq -r '.Credentials.SecretAccessKey')
                              export AWS_SESSION_TOKEN=$(echo "$CREDS" | jq -r '.Credentials.SessionToken')

                              aws sts get-caller-identity

                              rm -rf /tmp/infrastructure.raas.terraform.live /tmp/src /tmp/unzipped_archive

                              mkdir -p /tmp/src/glue /tmp/unzipped_archive

                              cd /tmp/unzipped_archive

                              if [ "<+pipeline.variables.package_version>" = "NA" ]; then
                                src_file="<+pipeline.variables.trigger_package>"
                              else
                                src_file="<+pipeline.variables.module_name>-<+pipeline.variables.package_version>.zip"
                              fi

                              file_url="<+pipeline.variables.artifactory_url>/<+pipeline.variables.artifactory_repo>/<+pipeline.variables.framework_name>/$src_file"

                              echo "Downloading $file_url"
                              wget "$file_url"

                              unzip -o "$src_file" -d /tmp/src/glue

                              test -f /tmp/src/glue/glue_redaction.py
                              test -d /tmp/src/glue/pci_redaction

                              cd /tmp
                              git clone git@bitbucket.org:deluxe-development/infrastructure.raas.terraform.live.git

                              cd /tmp/infrastructure.raas.terraform.live
                              git checkout "<+pipeline.variables.branch_name>"

                              cd "<+pipeline.variables.aws_lz>/<+pipeline.variables.aws_region>/<+pipeline.variables.environment>/pci-redaction/glues/glue-batch-processor"

                              sed -i "s/REPLACE/$src_file/g" terragrunt.hcl

                              echo "Running Redaction Glue Terragrunt Plan"
                              terragrunt plan

                              rm -rf /tmp/infrastructure.raas.terraform.live /tmp/src /tmp/unzipped_archive

                              unset AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN TENV_AUTO_INSTALL
                        environmentVariables: []
                        outputVariables: []
                      timeout: 45m

                  # ------------------------------
                  # APPLY APPROVAL
                  # ------------------------------
                  - step:
                      type: HarnessApproval
                      name: Redaction Glue Apply Approval
                      identifier: Redaction_Glue_Apply_Approval
                      spec:
                        approvalMessage: Please review the Redaction Batch Ingestion Glue deployment plan and approve.
                        includePipelineExecutionHistory: true
                        isAutoRejectEnabled: false
                        approvers:
                          userGroups:
                            - account.Harness_RaaS_DevOps
                            - account.Harness_RaaS_Dev
                            - account.Harness_RaaS_QA
                          minimumCount: 1
                          disallowPipelineExecutor: false
                        approverInputs: []
                      timeout: 1h
                      when:
                        stageStatus: Success
                        condition: <+pipeline.variables.deploy_action> == "apply" && <+pipeline.triggerType> == "MANUAL"

                  # ------------------------------
                  # DESTROY APPROVAL
                  # ------------------------------
                  - step:
                      type: HarnessApproval
                      name: Redaction Glue Destroy Approval
                      identifier: Redaction_Glue_Destroy_Approval
                      spec:
                        approvalMessage: Please review and approve the Redaction Batch Ingestion Glue destroy operation.
                        includePipelineExecutionHistory: true
                        isAutoRejectEnabled: false
                        approvers:
                          userGroups:
                            - account.Harness_RaaS_DevOps
                          minimumCount: 1
                          disallowPipelineExecutor: false
                        approverInputs: []
                      timeout: 1h
                      when:
                        stageStatus: Success
                        condition: <+pipeline.variables.deploy_action> == "destroy"

                  # ------------------------------
                  # APPLY
                  # ------------------------------
                  - step:
                      type: ShellScript
                      name: Redaction Glue Terragrunt Apply
                      identifier: Redaction_Glue_Terragrunt_Apply
                      spec:
                        shell: Bash
                        executionTarget: {}
                        source:
                          type: Inline
                          spec:
                            script: |-
                              set -euo pipefail

                              export TENV_AUTO_INSTALL=true
                              export TERRAGRUNT_TFPATH=tofu

                              case "<+pipeline.variables.env_delegate>" in
                                dev-iac-delegate)
                                  ROLE_ARN="arn:aws:iam::697179190149:role/Terraform-Admin-Role"
                                  ;;
                                nonprod-iac-delegate)
                                  ROLE_ARN="arn:aws:iam::518383396166:role/Terraform-Admin-Role"
                                  ;;
                                prod-iac-delegate)
                                  ROLE_ARN="arn:aws:iam::908976231039:role/Terraform-Admin-Role"
                                  ;;
                                *)
                                  echo "Invalid delegate"
                                  exit 1
                                  ;;
                              esac

                              CREDS=$(aws sts assume-role --role-arn "$ROLE_ARN" --role-session-name RedactionGlueApply)

                              export AWS_ACCESS_KEY_ID=$(echo "$CREDS" | jq -r '.Credentials.AccessKeyId')
                              export AWS_SECRET_ACCESS_KEY=$(echo "$CREDS" | jq -r '.Credentials.SecretAccessKey')
                              export AWS_SESSION_TOKEN=$(echo "$CREDS" | jq -r '.Credentials.SessionToken')

                              aws sts get-caller-identity

                              rm -rf /tmp/infrastructure.raas.terraform.live /tmp/src /tmp/unzipped_archive
                              mkdir -p /tmp/src/glue /tmp/unzipped_archive

                              cd /tmp/unzipped_archive

                              if [ "<+pipeline.variables.package_version>" = "NA" ]; then
                                src_file="<+pipeline.variables.trigger_package>"
                              else
                                src_file="<+pipeline.variables.module_name>-<+pipeline.variables.package_version>.zip"
                              fi

                              file_url="<+pipeline.variables.artifactory_url>/<+pipeline.variables.artifactory_repo>/<+pipeline.variables.framework_name>/$src_file"

                              wget "$file_url"
                              unzip -o "$src_file" -d /tmp/src/glue

                              test -f /tmp/src/glue/glue_redaction.py
                              test -d /tmp/src/glue/pci_redaction

                              cd /tmp
                              git clone git@bitbucket.org:deluxe-development/infrastructure.raas.terraform.live.git

                              cd /tmp/infrastructure.raas.terraform.live
                              git checkout "<+pipeline.variables.branch_name>"

                              cd "<+pipeline.variables.aws_lz>/<+pipeline.variables.aws_region>/<+pipeline.variables.environment>/pci-redaction/glues/glue-batch-processor"

                              sed -i "s/REPLACE/$src_file/g" terragrunt.hcl

                              terragrunt apply --auto-approve

                              rm -rf /tmp/infrastructure.raas.terraform.live /tmp/src /tmp/unzipped_archive
                              unset AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN TENV_AUTO_INSTALL
                        environmentVariables: []
                        outputVariables: []
                      timeout: 45m
                      when:
                        stageStatus: Success
                        condition: <+pipeline.variables.deploy_action> == "apply"

                  # ------------------------------
                  # DESTROY
                  # ------------------------------
                  - step:
                      type: ShellScript
                      name: Redaction Glue Terragrunt Destroy
                      identifier: Redaction_Glue_Terragrunt_Destroy
                      spec:
                        shell: Bash
                        executionTarget: {}
                        source:
                          type: Inline
                          spec:
                            script: |-
                              set -euo pipefail

                              export TENV_AUTO_INSTALL=true
                              export TERRAGRUNT_TFPATH=tofu

                              case "<+pipeline.variables.env_delegate>" in
                                dev-iac-delegate)
                                  ROLE_ARN="arn:aws:iam::697179190149:role/Terraform-Admin-Role"
                                  ;;
                                nonprod-iac-delegate)
                                  ROLE_ARN="arn:aws:iam::518383396166:role/Terraform-Admin-Role"
                                  ;;
                                prod-iac-delegate)
                                  ROLE_ARN="arn:aws:iam::908976231039:role/Terraform-Admin-Role"
                                  ;;
                                *)
                                  echo "Invalid delegate"
                                  exit 1
                                  ;;
                              esac

                              CREDS=$(aws sts assume-role --role-arn "$ROLE_ARN" --role-session-name RedactionGlueDestroy)

                              export AWS_ACCESS_KEY_ID=$(echo "$CREDS" | jq -r '.Credentials.AccessKeyId')
                              export AWS_SECRET_ACCESS_KEY=$(echo "$CREDS" | jq -r '.Credentials.SecretAccessKey')
                              export AWS_SESSION_TOKEN=$(echo "$CREDS" | jq -r '.Credentials.SessionToken')

                              aws sts get-caller-identity

                              rm -rf /tmp/infrastructure.raas.terraform.live

                              cd /tmp
                              git clone git@bitbucket.org:deluxe-development/infrastructure.raas.terraform.live.git

                              cd /tmp/infrastructure.raas.terraform.live
                              git checkout "<+pipeline.variables.branch_name>"

                              cd "<+pipeline.variables.aws_lz>/<+pipeline.variables.aws_region>/<+pipeline.variables.environment>/pci-redaction/glues/glue-batch-processor"

                              terragrunt destroy --auto-approve

                              rm -rf /tmp/infrastructure.raas.terraform.live
                              unset AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN TENV_AUTO_INSTALL
                        environmentVariables: []
                        outputVariables: []
                      timeout: 45m
                      when:
                        stageStatus: Success
                        condition: <+pipeline.variables.deploy_action> == "destroy"
            tags: {}
            when:
              pipelineStatus: Success
              condition: <+pipeline.variables.aws_lz> == "DEV" || <+pipeline.variables.aws_lz> == "NONPROD"

        # ==========================================
        # HIGHER ENVIRONMENT - PROD
        # ==========================================
